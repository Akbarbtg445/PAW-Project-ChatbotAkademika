<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen selection:bg-indigo-500 selection:text-white">

  <!-- Toast Notification -->
  <div id="toast" class="fixed top-5 right-5 z-50 transform transition-all duration-300 translate-y-[-100px] opacity-0 pointer-events-none">
    <div id="toast-content" class="flex items-center px-5 py-3.5 rounded-2xl shadow-2xl text-sm font-semibold space-x-3 bg-emerald-950 border border-emerald-700 text-emerald-200">
      <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400"></i>
      <span id="toast-message">Operasi berhasil dilakukan!</span>
    </div>
  </div>

  <!-- Navbar Admin -->
  <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Logo & Role -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
          <i class="fa-solid fa-gauge-high"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-bold text-base sm:text-lg text-white"><%= appName %></span>
            <span class="px-2 py-0.5 text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 rounded-full">Admin BAAK</span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">Panel Kelola Basis Pengetahuan & AI Grounding</p>
        </div>
      </div>

      <!-- Action buttons & Profile -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a href="/" target="_blank" class="px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition flex items-center space-x-2">
          <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
          <span class="hidden sm:inline">Lihat Portal Mahasiswa</span>
          <span class="sm:hidden">Situs</span>
        </a>

        <!-- Admin Profile & Logout -->
        <div class="flex items-center space-x-3 pl-2 sm:pl-3 border-l border-slate-800">
          <div class="hidden md:block text-right">
            <div class="text-xs font-bold text-white">Supri Sunandar</div>
            <div class="text-[10px] text-slate-400">Staff Layanan Akademik</div>
          </div>
          <button onclick="handleLogout()" title="Keluar dari Dasbor" class="w-9 h-9 rounded-xl bg-red-950/40 hover:bg-red-900/60 border border-red-800/40 text-red-300 flex items-center justify-center transition">
            <i class="fa-solid fa-right-from-bracket text-xs"></i>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Stat Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Stat 1: Total FAQ -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Pengetahuan FAQ</span>
          <div class="w-9 h-9 rounded-xl bg-indigo-950 text-indigo-400 flex items-center justify-center border border-indigo-800/50">
            <i class="fa-solid fa-database text-sm"></i>
          </div>
        </div>
        <div class="mt-3 flex items-baseline space-x-2">
          <span id="stat-total" class="text-3xl font-extrabold text-white"><%= totalFaq %></span>
          <span class="text-xs text-slate-400">entri tersimpan</span>
        </div>
        <div class="mt-2 text-xs text-indigo-400 flex items-center">
          <i class="fa-solid fa-circle-check mr-1.5 text-[10px]"></i> Siap disajikan oleh chatbot
        </div>
      </div>

      <!-- Stat 2: Kategori -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Kategori Topik</span>
          <div class="w-9 h-9 rounded-xl bg-emerald-950 text-emerald-400 flex items-center justify-center border border-emerald-800/50">
            <i class="fa-solid fa-layer-group text-sm"></i>
          </div>
        </div>
        <div class="mt-3 flex items-baseline space-x-2">
          <span id="stat-kategori" class="text-3xl font-extrabold text-white"><%= categories.length %></span>
          <span class="text-xs text-slate-400">bidang akademik</span>
        </div>
        <div class="mt-2 text-xs text-emerald-400 flex items-center">
          <i class="fa-solid fa-tags mr-1.5 text-[10px]"></i> KRS, Kalender, BAAK, dll.
        </div>
      </div>

      <!-- Stat 3: Status AI Grounding -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Engine AI Grounding</span>
          <div class="w-9 h-9 rounded-xl bg-purple-950 text-purple-400 flex items-center justify-center border border-purple-800/50">
            <i class="fa-solid fa-microchip text-sm"></i>
          </div>
        </div>
        <div class="mt-3 flex items-baseline space-x-2">
          <span class="text-2xl font-bold text-white">Google Gemini</span>
        </div>
        <div class="mt-2 text-xs text-purple-300 flex items-center">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-2"></span> Terhubung & Ter-grounding
        </div>
      </div>

      <!-- Stat 4: Database Storage -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Database Penyimpanan</span>
          <div class="w-9 h-9 rounded-xl bg-cyan-950 text-cyan-400 flex items-center justify-center border border-cyan-800/50">
            <i class="fa-solid fa-server text-sm"></i>
          </div>
        </div>
        <div class="mt-3 flex items-baseline space-x-2">
          <span class="text-2xl font-bold text-white">PostgreSQL</span>
        </div>
        <div class="mt-2 text-xs text-cyan-300 flex items-center">
          <i class="fa-solid fa-bolt mr-1.5 text-[10px]"></i> Pool Connection Aktif
        </div>
      </div>

    </div>

    <!-- Management Section -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
      
      <!-- Top Toolbar (Search, Filter, Add CTA) -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center">
            <i class="fa-solid fa-book-bookmark text-indigo-500 mr-3"></i>
            Daftar Pengetahuan FAQ Akademik
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Data ini menjadi referensi utama (grounding) asisten AI saat menjawab pertanyaan mahasiswa.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Search Box -->
          <div class="relative flex-1 sm:flex-initial">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500 pointer-events-none">
              <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </span>
            <input 
              type="text" 
              id="search-input" 
              oninput="filterFaqs()"
              placeholder="Cari pertanyaan/topik..." 
              class="w-full sm:w-64 pl-9 pr-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
          </div>

          <!-- Category Filter -->
          <select 
            id="category-filter" 
            onchange="filterFaqs()" 
            class="bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs sm:text-sm text-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="">Semua Kategori</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          </select>

          <!-- Add Button -->
          <button 
            onclick="openFaqModal('create')" 
            class="px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-600 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg shadow-indigo-600/30 transition flex items-center space-x-2"
          >
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Tambah Data FAQ</span>
          </button>
        </div>
      </div>

      <!-- FAQ Table -->
      <div class="overflow-x-auto rounded-2xl border border-slate-800">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-950/80 border-b border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-4 w-16 text-center">ID</th>
              <th class="py-3.5 px-4 w-44">Kategori</th>
              <th class="py-3.5 px-4 min-w-[220px]">Pertanyaan Mahasiswa</th>
              <th class="py-3.5 px-4 min-w-[280px]">Jawaban Resmi</th>
              <th class="py-3.5 px-4 w-28 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="faq-tbody" class="divide-y divide-slate-800/60 text-xs sm:text-sm">
            <% if (faqs && faqs.length > 0) { %>
              <% faqs.forEach(faq => { %>
                <tr class="faq-row hover:bg-slate-800/40 transition" data-id="<%= faq.id %>" data-kategori="<%= faq.kategori %>" data-pertanyaan="<%= faq.pertanyaan.toLowerCase() %>" data-jawaban="<%= faq.jawaban.toLowerCase() %>">
                  <td class="py-3.5 px-4 text-center font-mono text-xs text-slate-500">#<%= faq.id %></td>
                  <td class="py-3.5 px-4">
                    <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-semibold bg-indigo-950 text-indigo-300 border border-indigo-800/50">
                      <%= faq.kategori %>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 font-medium text-slate-100">
                    <%= faq.pertanyaan %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-400 leading-relaxed">
                    <div class="line-clamp-2" title="<%= faq.jawaban %>">
                      <%= faq.jawaban %>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-center">
                    <div class="flex items-center justify-center space-x-2">
                      <button 
                        onclick="editFaq(<%= faq.id %>)" 
                        title="Edit Data" 
                        class="w-8 h-8 rounded-lg bg-amber-950/40 hover:bg-amber-900/60 border border-amber-800/40 text-amber-300 flex items-center justify-center transition"
                      >
                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                      </button>
                      <button 
                        onclick="deleteFaq(<%= faq.id %>)" 
                        title="Hapus Data" 
                        class="w-8 h-8 rounded-lg bg-red-950/40 hover:bg-red-900/60 border border-red-800/40 text-red-300 flex items-center justify-center transition"
                      >
                        <i class="fa-solid fa-trash text-xs"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr id="empty-row">
                <td colspan="5" class="py-12 text-center text-slate-500">
                  <i class="fa-solid fa-folder-open text-3xl mb-3 block text-slate-600"></i>
                  Belum ada data FAQ akademik di database PostgreSQL.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- No match search message -->
      <div id="no-search-match" class="hidden py-8 text-center text-slate-400 text-sm">
        <i class="fa-solid fa-magnifying-glass text-xl mb-2 text-slate-500 block"></i>
        Tidak ditemukan FAQ yang sesuai dengan filter pencarian Anda.
      </div>

    </div>

  </main>

  <!-- MODAL: Tambah / Edit FAQ -->
  <div id="faq-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative">
      
      <!-- Close Button -->
      <button onclick="closeFaqModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <div class="flex items-center space-x-3 mb-6">
        <div id="modal-icon-container" class="w-10 h-10 rounded-xl bg-indigo-950 text-indigo-400 flex items-center justify-center border border-indigo-800/50">
          <i id="modal-icon" class="fa-solid fa-circle-plus"></i>
        </div>
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-white">Tambah Data FAQ Baru</h3>
          <p id="modal-subtitle" class="text-xs text-slate-400">Endpoint: POST /api/faq (PostgreSQL)</p>
        </div>
      </div>

      <form id="faq-modal-form" onsubmit="handleFaqSubmit(event)" class="space-y-4">
        <input type="hidden" id="modal-faq-id">

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Kategori Akademik</label>
          <input 
            type="text" 
            id="modal-kategori" 
            required 
            placeholder="Misal: KRS, Jadwal Kuliah, BAAK, Yudisium" 
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Pertanyaan Mahasiswa</label>
          <input 
            type="text" 
            id="modal-pertanyaan" 
            required 
            placeholder="Contoh: Kapan batas akhir pengisian KRS semester genap?" 
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Jawaban Resmi / Prosedur</label>
          <textarea 
            id="modal-jawaban" 
            rows="4" 
            required 
            placeholder="Tuliskan jawaban yang detail, jelas, dan akurat untuk dipelajari chatbot..." 
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ></textarea>
        </div>

        <div class="flex items-center space-x-3 pt-3">
          <button 
            type="button" 
            onclick="closeFaqModal()" 
            class="flex-1 py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-sm transition"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="modal-submit-btn" 
            class="flex-1 py-2.5 px-4 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/30 transition flex items-center justify-center space-x-2"
          >
            <i class="fa-solid fa-floppy-disk text-xs"></i>
            <span id="modal-submit-text">Simpan ke DB</span>
          </button>
        </div>

      </form>

    </div>
  </div>

  <script>
    // Cek autentikasi sederhana client-side
    document.addEventListener('DOMContentLoaded', () => {
      const isAuth = sessionStorage.getItem('admin_auth');
      if (!isAuth) {
        // Jika belum login, arahkan ke /login
        window.location.href = '/login';
      }
    });

    function handleLogout() {
      if (confirm('Apakah Anda ingin keluar dari panel admin?')) {
        sessionStorage.removeItem('admin_auth');
        sessionStorage.removeItem('admin_user');
        window.location.href = '/login';
      }
    }

    function showToast(message, isError = false) {
      const toast = document.getElementById('toast');
      const content = document.getElementById('toast-content');
      const icon = document.getElementById('toast-icon');
      const msg = document.getElementById('toast-message');

      msg.textContent = message;
      if (isError) {
        content.className = 'flex items-center px-5 py-3.5 rounded-2xl shadow-2xl text-sm font-semibold space-x-3 bg-red-950 border border-red-700 text-red-200';
        icon.className = 'fa-solid fa-circle-exclamation text-red-400';
      } else {
        content.className = 'flex items-center px-5 py-3.5 rounded-2xl shadow-2xl text-sm font-semibold space-x-3 bg-emerald-950 border border-emerald-700 text-emerald-200';
        icon.className = 'fa-solid fa-circle-check text-emerald-400';
      }

      toast.classList.remove('translate-y-[-100px]', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-[-100px]', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    function filterFaqs() {
      const q = document.getElementById('search-input').value.toLowerCase().trim();
      const cat = document.getElementById('category-filter').value;
      const rows = document.querySelectorAll('.faq-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const rowCat = row.getAttribute('data-kategori');
        const rowPertanyaan = row.getAttribute('data-pertanyaan');
        const rowJawaban = row.getAttribute('data-jawaban');

        const matchCat = !cat || rowCat === cat;
        const matchQuery = !q || rowPertanyaan.includes(q) || rowJawaban.includes(q);

        if (matchCat && matchQuery) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const noMatch = document.getElementById('no-search-match');
      if (rows.length > 0 && visibleCount === 0) {
        noMatch.classList.remove('hidden');
      } else {
        noMatch.classList.add('hidden');
      }
    }

    function openFaqModal(mode, data = {}) {
      const modal = document.getElementById('faq-modal');
      const title = document.getElementById('modal-title');
      const subtitle = document.getElementById('modal-subtitle');
      const submitText = document.getElementById('modal-submit-text');
      const idField = document.getElementById('modal-faq-id');
      const catField = document.getElementById('modal-kategori');
      const qField = document.getElementById('modal-pertanyaan');
      const aField = document.getElementById('modal-jawaban');

      if (mode === 'create') {
        title.textContent = 'Tambah Data FAQ Baru';
        subtitle.textContent = 'Endpoint: POST /api/faq (Simpan ke PostgreSQL)';
        submitText.textContent = 'Simpan ke DB';
        idField.value = '';
        catField.value = '';
        qField.value = '';
        aField.value = '';
      } else {
        title.textContent = `Perbarui Data FAQ #${data.id}`;
        subtitle.textContent = `Endpoint: PUT /api/faq/${data.id} (Update PostgreSQL)`;
        submitText.textContent = 'Perbarui Data';
        idField.value = data.id;
        catField.value = data.kategori || '';
        qField.value = data.pertanyaan || '';
        aField.value = data.jawaban || '';
      }

      modal.classList.remove('hidden');
    }

    function closeFaqModal() {
      document.getElementById('faq-modal').classList.add('hidden');
    }

    async function editFaq(id) {
      try {
        const res = await fetch(`/api/faq/${id}`);
        const result = await res.json();
        if (result.status === 'success' && result.data) {
          openFaqModal('edit', result.data);
        } else {
          showToast(result.message || 'Gagal memuat detail FAQ', true);
        }
      } catch (err) {
        showToast('Terjadi kesalahan koneksi: ' + err.message, true);
      }
    }

    async function handleFaqSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('modal-faq-id').value;
      const kategori = document.getElementById('modal-kategori').value.trim();
      const pertanyaan = document.getElementById('modal-pertanyaan').value.trim();
      const jawaban = document.getElementById('modal-jawaban').value.trim();

      const isEdit = !!id;
      const url = isEdit ? `/api/faq/${id}` : '/api/faq';
      const method = isEdit ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kategori, pertanyaan, jawaban })
        });
        const result = await res.json();

        if (res.ok && result.status === 'success') {
          showToast(isEdit ? 'Data FAQ berhasil diperbarui!' : 'Data FAQ baru berhasil ditambahkan!');
          closeFaqModal();
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(result.message || 'Gagal menyimpan data', true);
        }
      } catch (err) {
        showToast('Terjadi kesalahan jaringan: ' + err.message, true);
      }
    }

    async function deleteFaq(id) {
      if (!confirm(`Apakah Anda yakin ingin menghapus data FAQ #${id}? Tindakan ini akan menghapus data dari PostgreSQL.`)) {
        return;
      }

      try {
        const res = await fetch(`/api/faq/${id}`, { method: 'DELETE' });
        const result = await res.json();

        if (res.ok && result.status === 'success') {
          showToast(`Data FAQ #${id} berhasil dihapus.`);
          const row = document.querySelector(`.faq-row[data-id="${id}"]`);
          if (row) row.remove();
          // Update total stat
          const statTotal = document.getElementById('stat-total');
          if (statTotal) {
            statTotal.textContent = Math.max(0, parseInt(statTotal.textContent) - 1);
          }
        } else {
          showToast(result.message || 'Gagal menghapus data', true);
        }
      } catch (err) {
        showToast('Terjadi kesalahan: ' + err.message, true);
      }
    }
  </script>
</body>
</html>
