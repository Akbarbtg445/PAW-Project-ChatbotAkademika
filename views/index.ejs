        </button>
        <button onclick="filterProducts('Kelulusan', this)" class="product-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 transition-all duration-300">
