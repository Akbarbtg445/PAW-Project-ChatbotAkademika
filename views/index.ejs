<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-200">
          <i class="fa-solid fa-robot text-lg"></i>
        </div>
        <div>
          <span class="font-bold text-lg text-slate-900 tracking-tight"><%= appName %></span>
          <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-xs font-medium bg-indigo-100 text-indigo-700 rounded-full">v<%= appVersion %></span>
        </div>
      </div>

      <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-600">
        <a href="#fitur" class="hover:text-indigo-600 transition">Fitur Utama</a>
        <a href="#produk" class="hover:text-indigo-600 transition">Katalog Produk/Layanan</a>
        <a href="#chat-demo" class="hover:text-indigo-600 transition">Demo Chatbot</a>
        <a href="#api-tester" class="hover:text-indigo-600 transition">API Endpoints</a>
        <a href="#tim" class="hover:text-indigo-600 transition">Tim Pengembang</a>
      </nav>

      <div class="flex items-center space-x-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
          <span class="w-2 h-2 mr-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
          Server Aktif
        </span>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-indigo-50/60 to-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 mb-6 text-xs font-medium text-indigo-700 bg-indigo-100/80 rounded-full">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Pengembangan Aplikasi Web - Week 7</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Asisten Cerdas Informasi <br class="hidden sm:inline" />
        <span class="text-indigo-600">Akademik Kampus</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        <%= description %>. Memudahkan mahasiswa menemukan panduan KRS, kalender akademik, berkas administrasi, dan prosedur yudisium secara cepat, terpadu, dan konsisten.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#chat-demo" class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-lg shadow-indigo-200 transition flex items-center space-x-2">
          <i class="fa-solid fa-comments"></i>
          <span>Coba Chatbot Demo</span>
        </a>
        <a href="#api-tester" class="px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-semibold border border-slate-300 shadow-sm transition flex items-center space-x-2">
          <i class="fa-solid fa-network-wired"></i>
          <span>Uji REST API</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section: Chatbot Demo Preview (Based on PRD US-01, US-02, US-03, F-01, F-02, F-03) -->
  <section id="chat-demo" class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600">Simulasi Antarmuka Mahasiswa</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">Pratinjau Interaktif Chatbot Akademika</h2>
        <p class="text-slate-500 text-sm mt-2">Mendukung input pertanyaan manual dan shortcut pertanyaan populer sesuai PRD.</p>
      </div>

      <!-- Chat Container -->
      <div class="bg-slate-50 rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
        <!-- Chat Header -->
        <div class="bg-indigo-600 text-white px-6 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div>
              <h3 class="font-semibold text-sm">Bot Akademika BAAK</h3>
              <p class="text-xs text-indigo-200 flex items-center">
                <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full"></span> Respons cepat (&lt; 3s)
              </p>
            </div>
          </div>
          <span class="text-xs bg-indigo-700/60 px-3 py-1 rounded-full border border-indigo-400/30">AIML Engine Ready</span>
        </div>

        <!-- Chat Messages Box -->
        <div id="chat-box" class="p-6 space-y-4 h-80 overflow-y-auto">
          <!-- Bot Welcome Message -->
          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-xs">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700">
              Halo! Saya <strong>Chatbot Akademika</strong>. Ada yang bisa saya bantu terkait jadwal, alur KRS, kalender akademik, atau administrasi BAAK?
            </div>
          </div>
        </div>

        <!-- Popular Questions / Shortcuts (PRD US-02 / F-02) -->
        <div class="px-6 py-3 bg-indigo-50/70 border-t border-slate-200">
          <p class="text-xs font-semibold text-slate-500 mb-2 flex items-center">
            <i class="fa-solid fa-bolt text-indigo-500 mr-1.5"></i> Pertanyaan Populer:
          </p>
          <div class="flex flex-wrap gap-2">
            <% popularQuestions.forEach(question => { %>
              <button onclick="sendQuickQuestion('<%= question %>')" class="text-xs bg-white hover:bg-indigo-600 hover:text-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 transition shadow-sm">
                <%= question %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white border-t border-slate-200">
          <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex space-x-3">
            <input 
              type="text" 
              id="user-input" 
              placeholder="Ketik pertanyaan akademik Anda di sini (misal: jadwal KRS, syarat yudisium)..." 
              class="flex-1 px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            />
            <button 
              type="submit" 
              class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition flex items-center space-x-2"
            >
              <span>Kirim</span>
              <i class="fa-solid fa-paper-plane text-xs"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Data Produk / Layanan Akademik (Dynamic from Backend) -->
  <section id="produk" class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600">Model Data Backend (MVC)</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">Daftar Modul & Layanan Akademika</h2>
        <p class="text-slate-500 text-sm mt-2">
          Data berikut dirender secara dinamis dari Model Express.js (<code class="bg-slate-200 px-1 py-0.5 rounded text-xs">models/productModel.js</code>).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% products.forEach(product => { %>
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                  <i class="fa-solid <%= product.ikon %>"></i>
                </div>
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 text-slate-600">
                  <%= product.kategori %>
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2"><%= product.nama %></h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4"><%= product.deskripsi %></p>
            </div>
            
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md">
                <i class="fa-solid fa-circle-check mr-1"></i> <%= product.tipe %>
              </span>
              <span class="text-slate-400">ID: #<%= product.id %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Section: Live API Endpoint Tester -->
  <section id="api-tester" class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600">REST API & Middleware Logger</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">Pengujian Endpoint Langsung</h2>
        <p class="text-slate-500 text-sm mt-2">
          Uji endpoint backend secara langsung dari browser. Setiap request akan otomatis tercatat pada terminal/console backend oleh Middleware Logger.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Card Endpoint 1: GET /api/status -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
              <span class="px-2.5 py-1 text-xs font-bold bg-emerald-600 text-white rounded-md">GET</span>
              <code class="text-sm font-semibold text-slate-800">/api/status</code>
            </div>
            <button 
              onclick="testApi('/api/status', 'status-output', 'status-badge')"
              class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1.5 shadow-sm"
            >
              <i class="fa-solid fa-play text-[10px]"></i>
              <span>Kirim Request</span>
            </button>
          </div>
          <p class="text-xs text-slate-500 mb-3">Mengembalikan status kesehatan server dan info aplikasi.</p>
          
          <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
            <span>Response:</span>
            <span id="status-badge" class="font-medium text-slate-400">Belum diuji</span>
          </div>
          <pre id="status-output" class="bg-slate-900 text-slate-100 p-4 rounded-xl text-xs overflow-x-auto h-48 font-mono">// Klik "Kirim Request" untuk melihat response JSON...</pre>
        </div>

        <!-- Card Endpoint 2: GET /api/produk -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
              <span class="px-2.5 py-1 text-xs font-bold bg-emerald-600 text-white rounded-md">GET</span>
              <code class="text-sm font-semibold text-slate-800">/api/produk</code>
            </div>
            <button 
              onclick="testApi('/api/produk', 'produk-output', 'produk-badge')"
              class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1.5 shadow-sm"
            >
              <i class="fa-solid fa-play text-[10px]"></i>
              <span>Kirim Request</span>
            </button>
          </div>
          <p class="text-xs text-slate-500 mb-3">Mengembalikan daftar produk/layanan dalam bentuk array JSON.</p>
          
          <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
            <span>Response:</span>
            <span id="produk-badge" class="font-medium text-slate-400">Belum diuji</span>
          </div>
          <pre id="produk-output" class="bg-slate-900 text-slate-100 p-4 rounded-xl text-xs overflow-x-auto h-48 font-mono">// Klik "Kirim Request" untuk melihat response JSON...</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Tim Pengembang (Based on PRD Header) -->
  <section id="tim" class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600">Kolaborasi & Anggota Tim</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">Tim Pengembang Chatbot Akademika</h2>
        <p class="text-slate-500 text-sm mt-2">
          Project Kelompok Pengembangan Aplikasi Web (PAW) - Semester Ganjil 2026/2027.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% teamMembers.forEach((member, idx) => { %>
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm flex-shrink-0">
              <%= member.name.charAt(0) %>
            </div>
            <div class="overflow-hidden">
              <h4 class="text-sm font-semibold text-slate-800 truncate"><%= member.name %></h4>
              <p class="text-xs text-slate-500 font-mono"><%= member.nim %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-10 border-t border-slate-800 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-robot text-indigo-400 text-lg"></i>
        <span class="font-bold text-white"><%= appName %></span>
        <span class="text-slate-500">| PAW Week 7 Integration Project</span>
      </div>
      <p class="text-xs text-slate-400">
        Dibangun dengan Express.js, EJS, Tailwind CSS & REST API Architecture (MVC).
      </p>
    </div>
  </footer>

  <!-- Frontend Logic Scripts -->
  <script>
    // Knowledge Base sederhana untuk demo chatbot sesuai PRD (US-01, US-02, US-03)
    const knowledgeBase = [
      {
        patterns: ["krs", "isi krs", "alur krs", "pengisian krs"],
        answer: "Alur pengisian KRS: 1) Login ke SIAKAD, 2) Pastikan tagihan SPP semester telah lunas, 3) Pilih menu 'KRS Online', 4) Ambil mata kuliah sesuai semester & prasyarat, 5) Klik ajukan dan minta persetujuan Dosen Pembimbing Akademik (DPA)."
      },
      {
        patterns: ["jadwal", "kalender", "ukt", "revisi krs", "batas pembayaran"],
        answer: "Berdasarkan Kalender Akademik: Batas pembayaran UKT berlangsung hingga minggu ke-2 semester. Revisi KRS (tambah/batal matkul) dibuka selama 5 hari kerja setelah masa perkuliahan dimulai."
      },
      {
        patterns: ["bebas pustaka", "perpustakaan", "skripsi", "plagiasi", "turnitin"],
        answer: "Syarat bebas pustaka: 1) Tidak memiliki tunggakan pinjaman buku, 2) Menyerahkan softcopy file skripsi format PDF & docx, 3) Bukti lolos uji Turnitin maksimal similarity 20%."
      },
      {
        patterns: ["yudisium", "wisuda", "ijazah", "daftar yudisium"],
        answer: "Prosedur pendaftaran Yudisium: Lengkapi berkas bebas pustaka, transkrip nilai final tanpa nilai E, bukti skor TOEFL/TOEP min. 450, dan unggah formulir pendaftaran melalui loket BAAK."
      }
    ];

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('user-input');
      const text = input.value.trim();
      if (!text) return;

      appendChatMessage('user', text);
      input.value = '';

      // Tampilkan indikator mengetik sejenak untuk simulasi respons < 3s (PRD M-01)
      setTimeout(() => {
        const reply = findAnswer(text);
        appendChatMessage('bot', reply);
      }, 500);
    }

    function sendQuickQuestion(questionText) {
      appendChatMessage('user', questionText);
      setTimeout(() => {
        const reply = findAnswer(questionText);
        appendChatMessage('bot', reply);
      }, 500);
    }

    function findAnswer(query) {
      const lower = query.toLowerCase();
      for (const item of knowledgeBase) {
        if (item.patterns.some(pattern => lower.includes(pattern))) {
          return item.answer;
        }
      }
      // Fallback message sesuai PRD (US-03 / F-03)
      return "Maaf, informasi untuk pertanyaan tersebut belum tersedia di basis pengetahuan kami. Silakan coba kata kunci lain atau hubungi staf BAAK di layanan administrasi kampus.";
    }

    function appendChatMessage(sender, text) {
      const box = document.getElementById('chat-box');
      const wrapper = document.createElement('div');
      wrapper.className = `flex items-start space-x-3 ${sender === 'user' ? 'justify-end' : ''}`;

      if (sender === 'user') {
        wrapper.innerHTML = `
          <div class="bg-indigo-600 text-white p-3.5 rounded-2xl rounded-tr-none shadow-sm max-w-md text-sm">
            ${text}
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex-shrink-0 flex items-center justify-center text-xs font-bold">
            <i class="fa-solid fa-user"></i>
          </div>
        `;
      } else {
        wrapper.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">
            <i class="fa-solid fa-robot"></i>
          </div>
          <div class="bg-white border border-slate-200 p-3.5 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700">
            ${text}
          </div>
        `;
      }

      box.appendChild(wrapper);
      box.scrollTop = box.scrollHeight;
    }

    // Fungsi Pengujian REST API
    async function testApi(url, outputId, badgeId) {
      const outputElem = document.getElementById(outputId);
      const badgeElem = document.getElementById(badgeId);

      badgeElem.innerHTML = `<span class="text-amber-500"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Memuat...</span>`;
      outputElem.innerText = "// Mengirim request HTTP...";

      const t0 = performance.now();
      try {
        const res = await fetch(url);
        const t1 = performance.now();
        const duration = Math.round(t1 - t0);
        const data = await res.json();

        badgeElem.innerHTML = `<span class="text-emerald-600 font-semibold">${res.status} OK (${duration}ms)</span>`;
        outputElem.innerText = JSON.stringify(data, null, 2);
      } catch (err) {
        badgeElem.innerHTML = `<span class="text-rose-600 font-semibold">Error</span>`;
        outputElem.innerText = `Error: ${err.message}`;
      }
    }
  </script>
</body>
</html>
