<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- AOS (Animate On Scroll) CDN -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <style>
    /* Smooth Keyframe Animations */
    @keyframes chatSlideUp {
      from { opacity: 0; transform: translateY(12px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .chat-bubble-enter {
      animation: chatSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .feature-tab-btn.active {
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      color: #ffffff;
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.5);
      border-color: transparent;
    }
    .product-filter-btn.active {
      background-color: #4f46e5;
      color: #ffffff;
      box-shadow: 0 8px 20px -4px rgba(79, 70, 229, 0.4);
    }
    /* Smooth Transition for Feature Switcher */
    .tab-content-enter {
      animation: featureFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes featureFadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Navbar (Netflix Cinematic Dark Style) -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-robot text-lg"></i>
        </div>
        <div>
          <span class="font-bold text-lg text-white tracking-tight group-hover:text-indigo-400 transition-colors"><%= appName %></span>
          <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-xs font-semibold bg-indigo-900/80 text-indigo-300 border border-indigo-700/50 rounded-full">v<%= appVersion %></span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-slate-300">
        <a href="#fitur" class="hover:text-white transition">Fitur Utama</a>
        <a href="#produk" class="hover:text-white transition">Katalog Layanan</a>
        <a href="#persona" class="hover:text-white transition">Target Pengguna</a>
        <a href="#chat-demo" class="hover:text-white transition">Demo Chatbot</a>
        <a href="#api-tester" class="hover:text-white transition">Uji REST API</a>
        <a href="#tim" class="hover:text-white transition">Tim Pengembang</a>
      </nav>

      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-400 border border-emerald-800/80 shadow-sm">
          <span class="w-2 h-2 mr-2 bg-emerald-400 rounded-full animate-pulse"></span>
          Server Online (Port 3000)
        </span>
      </div>
    </div>
  </header>

  <!-- Hero Section (Netflix Cinematic Background with Real University Stock Photography) -->
  <section class="relative overflow-hidden min-h-[90vh] flex items-center justify-center border-b border-slate-800">
    
    <!-- Real Stock Photography Background (Bukan AI, 100% Real Photography dari Unsplash) -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=2000&q=80" 
        alt="Real University Campus Building - Photography by Vasily Kolotilov" 
        class="w-full h-full object-cover object-center scale-105 filter brightness-90 contrast-105"
      />
      <!-- Netflix Cinematic Radial Vignette: Dark edges, subtle center glow -->
      <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 45%, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.85) 60%, rgba(2, 6, 23, 0.98) 100%);"></div>
      
      <!-- Top to Bottom Gradient: Seamless blend with navbar and bottom section -->
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(2, 6, 23, 0.95) 0%, rgba(2, 6, 23, 0.3) 25%, rgba(2, 6, 23, 0.6) 70%, rgba(2, 6, 23, 1) 100%);"></div>
      
      <!-- Subtle Ambient Grid Texture for High-Tech feel -->
      <div class="absolute inset-0 opacity-15 bg-[linear-gradient(to_right,#6366f1_1px,transparent_1px),linear-gradient(to_bottom,#6366f1_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <!-- Hero Content (Netflix Center Style) -->
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      
      <!-- Academic Badge -->
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 mb-8 text-xs font-bold text-indigo-300 bg-indigo-950/80 rounded-full border border-indigo-700/60 shadow-xl backdrop-blur-md">
        <i class="fa-solid fa-graduation-cap text-indigo-400"></i>
        <span>PAW WEEK 7 &bull; CHATBOT AKADEMIKA KAMPUS</span>
      </div>

      <!-- Bold Cinematic Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-tight drop-shadow-2xl">
        Informasi Akademik & KRS <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-indigo-300 to-purple-400">
          Tanpa Batas Waktu.
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed drop-shadow">
        Tanyakan jadwal kuliah, alur KRS, kalender akademik, dan berkas administrasi BAAK kapan saja. Solusi konsisten dengan respon cepat &lt; 3 detik.
      </p>

      <!-- Netflix-style Call-To-Action / Question Input Bar -->
      <div class="mt-10 max-w-2xl mx-auto">
        <p class="text-xs uppercase tracking-wider font-semibold text-slate-300 mb-3.5 flex items-center justify-center">
          <i class="fa-solid fa-sparkles text-indigo-400 mr-2"></i>
          Siap bertanya? Masukkan topik akademik Anda untuk mulai percakapan:
        </p>

        <form onsubmit="handleHeroSearch(event)" class="flex flex-col sm:flex-row gap-2.5 p-2 bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-700/80 shadow-2xl focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/30 transition-all">
          <div class="flex-1 flex items-center px-4 py-2">
            <i class="fa-solid fa-magnifying-glass text-slate-400 mr-3"></i>
            <input 
              type="text" 
              id="hero-input"
              placeholder="Contoh: Bagaimana alur pengisian KRS? Kapan batas UKT?" 
              class="w-full bg-transparent text-white placeholder-slate-400 text-sm focus:outline-none"
            />
          </div>
          <button 
            type="submit" 
            class="px-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/40 transition-all flex items-center justify-center space-x-2 group flex-shrink-0"
          >
            <span>Mulai Tanya</span>
            <i class="fa-solid fa-chevron-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </button>
        </form>

        <!-- Trending Academic Tags / Shortcuts -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs text-slate-400">
          <span class="font-semibold text-slate-300 flex items-center">
            <i class="fa-solid fa-fire text-amber-400 mr-1.5"></i> Populer:
          </span>
          <button onclick="quickHeroQuestion('Bagaimana alur pengisian KRS semester baru?')" class="bg-slate-900/80 hover:bg-indigo-600 hover:text-white text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700/80 transition-colors shadow-sm">#AlurKRS</button>
          <button onclick="quickHeroQuestion('Kapan batas pembayaran UKT & revisi KRS?')" class="bg-slate-900/80 hover:bg-indigo-600 hover:text-white text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700/80 transition-colors shadow-sm">#BatasUKT</button>
          <button onclick="quickHeroQuestion('Apa saja syarat pengajuan bebas pustaka?')" class="bg-slate-900/80 hover:bg-indigo-600 hover:text-white text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700/80 transition-colors shadow-sm">#BebasPustaka</button>
          <button onclick="quickHeroQuestion('Bagaimana prosedur pendaftaran yudisium?')" class="bg-slate-900/80 hover:bg-indigo-600 hover:text-white text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700/80 transition-colors shadow-sm">#Yudisium</button>
        </div>
      </div>

      <!-- Bottom Quick Stats Row (Based on PRD Metrics) -->
      <div class="mt-14 pt-8 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="bg-slate-900/70 backdrop-blur-sm p-4 rounded-xl border border-slate-800/80">
          <p class="text-2xl font-black text-indigo-400">&lt; 3 Detik</p>
          <p class="text-xs text-slate-400 mt-1">Target Respon Jawaban</p>
        </div>
        <div class="bg-slate-900/70 backdrop-blur-sm p-4 rounded-xl border border-slate-800/80">
          <p class="text-2xl font-black text-indigo-400">100%</p>
          <p class="text-xs text-slate-400 mt-1">Pesan Fallback Terkelola</p>
        </div>
        <div class="bg-slate-900/70 backdrop-blur-sm p-4 rounded-xl border border-slate-800/80">
          <p class="text-2xl font-black text-indigo-400">24/7</p>
          <p class="text-xs text-slate-400 mt-1">Akses Mandiri Mahasiswa</p>
        </div>
        <div class="bg-slate-900/70 backdrop-blur-sm p-4 rounded-xl border border-slate-800/80">
          <p class="text-2xl font-black text-indigo-400">6 Modul</p>
          <p class="text-xs text-slate-400 mt-1">Layanan BAAK Terintegrasi</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Section: Fitur Utama (id="fitur" - Sesuai PRD F-01, F-02, F-03) -->
  <section id="fitur" class="py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title with AOS -->
      <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          Fitur & Spesifikasi PRD
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          Transisi & Eksplorasi Fitur Utama Chatbot
        </h2>
        <p class="text-slate-600 text-base mt-3">
          Klik tab di bawah untuk melihat animasi transisi dan cara kerja setiap fitur inti yang dirancang pada dokumen PRD.
        </p>

        <!-- Interactive Animated Feature Tabs -->
        <div class="mt-8 inline-flex p-1.5 bg-slate-100 rounded-2xl border border-slate-200 flex-wrap justify-center gap-1.5">
          <button 
            onclick="switchFeatureTab(1)" 
            id="tab-btn-1" 
            class="feature-tab-btn active px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600 hover:text-indigo-600"
          >
            <i class="fa-solid fa-brain"></i>
            <span>F-01: Pencocokan AIML</span>
          </button>
          <button 
            onclick="switchFeatureTab(2)" 
            id="tab-btn-2" 
            class="feature-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600 hover:text-indigo-600"
          >
            <i class="fa-solid fa-bolt"></i>
            <span>F-02: Shortcut Populer</span>
          </button>
          <button 
            onclick="switchFeatureTab(3)" 
            id="tab-btn-3" 
            class="feature-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600 hover:text-indigo-600"
          >
            <i class="fa-solid fa-shield-halved"></i>
            <span>F-03: Pesan Fallback BAAK</span>
          </button>
        </div>
      </div>

      <!-- Animated Feature Showcase Display (Switches with smooth fade & slide) -->
      <div class="mb-16 max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        
        <!-- Tab Pane 1: F-01 AIML Matching -->
        <div id="tab-pane-1" class="tab-pane tab-content-enter bg-gradient-to-br from-indigo-900 to-slate-900 text-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-indigo-800/50">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <span class="px-3 py-1 bg-indigo-500/30 text-indigo-300 text-xs font-bold rounded-full border border-indigo-400/30">
                Fitur Inti &bull; Prioritas: Must
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-3">
                Mesin Pencocokan Pola Kata Kunci AIML
              </h3>
              <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
                Setiap pesan mahasiswa dipindai terhadap basis pengetahuan aturan kampus. Pertanyaan tentang "krs", "isi krs", atau "syarat skripsi" langsung dipetakan ke jawaban resmi dalam waktu <strong>&lt; 3 detik</strong>.
              </p>
              
              <div class="mt-6 flex flex-wrap gap-2 text-xs">
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1.5 rounded-lg border border-indigo-700/60 font-mono">
                  Input: "jadwal krs" &rarr; Cocok dengan [Pattern: krs] &rarr; Output Respon BAAK
                </span>
              </div>
            </div>

            <div class="lg:col-span-5 bg-slate-950/80 p-5 rounded-2xl border border-indigo-500/30 shadow-inner">
              <div class="flex items-center justify-between text-xs text-indigo-300 pb-3 border-b border-slate-800">
                <span class="font-mono flex items-center"><i class="fa-solid fa-code mr-1.5"></i> AIML Logic Simulator</span>
                <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i> Active</span>
              </div>
              <div class="mt-4 space-y-2 text-xs font-mono">
                <div class="p-2.5 rounded-lg bg-indigo-900/40 text-indigo-200 border border-indigo-800/40">
                  <span class="text-slate-400">// Pertanyaan Mahasiswa:</span><br/>
                  &gt; "Bagaimana alur isi KRS?"
                </div>
                <div class="p-2.5 rounded-lg bg-emerald-950/40 text-emerald-300 border border-emerald-800/40">
                  <span class="text-slate-400">// Pola Terdeteksi:</span><br/>
                  MATCH: ["krs", "alur krs"] &bull; Delay: 420ms
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab Pane 2: F-02 Shortcut Questions -->
        <div id="tab-pane-2" class="tab-pane hidden tab-content-enter bg-gradient-to-br from-purple-900 to-slate-900 text-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-purple-800/50">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <span class="px-3 py-1 bg-purple-500/30 text-purple-300 text-xs font-bold rounded-full border border-purple-400/30">
                Akses Instan &bull; Prioritas: Should
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-3">
                Shortcut Pertanyaan Populer Sekali Klik
              </h3>
              <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
                Mahasiswa baru tidak perlu bingung menyusun kalimat formal. Cukup klik tombol pertanyaan yang sering ditanyakan, dan bot akan langsung merespons informasi terkait.
              </p>
              
              <div class="mt-6 flex flex-wrap gap-2">
                <button onclick="sendQuickQuestion('Bagaimana alur pengisian KRS semester baru?'); document.getElementById('chat-demo').scrollIntoView({behavior: 'smooth'});" class="px-3.5 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow transition-all">
                  Coba: Alur Pengisian KRS &rarr;
                </button>
                <button onclick="sendQuickQuestion('Kapan batas pembayaran UKT & revisi KRS?'); document.getElementById('chat-demo').scrollIntoView({behavior: 'smooth'});" class="px-3.5 py-1.5 rounded-lg bg-purple-950/80 hover:bg-purple-800 text-purple-200 text-xs font-semibold border border-purple-700/60 transition-all">
                  Coba: Batas UKT &rarr;
                </button>
              </div>
            </div>

            <div class="lg:col-span-5 bg-slate-950/80 p-5 rounded-2xl border border-purple-500/30 shadow-inner">
              <p class="text-xs text-purple-300 font-semibold mb-3">Simulasi Klik Shortcut:</p>
              <div class="space-y-2">
                <div class="p-3 bg-purple-950/60 rounded-xl border border-purple-800/50 flex items-center justify-between text-xs text-purple-200">
                  <span>Alur Pengisian KRS</span>
                  <i class="fa-solid fa-arrow-turn-down text-purple-400"></i>
                </div>
                <div class="p-3 bg-slate-900 rounded-xl border border-slate-800 text-xs text-slate-300">
                  <span class="text-emerald-400 font-semibold">Bot:</span> Menampilkan langkah 1-5 pengisian SIAKAD secara instan.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab Pane 3: F-03 Fallback Message -->
        <div id="tab-pane-3" class="tab-pane hidden tab-content-enter bg-gradient-to-br from-amber-950/90 via-slate-900 to-slate-950 text-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-amber-800/50">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <span class="px-3 py-1 bg-amber-500/30 text-amber-300 text-xs font-bold rounded-full border border-amber-400/30">
                Penanganan Error &bull; Prioritas: Must
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-3">
                Pesan Fallback Cerdas & Rekomendasi Loket
              </h3>
              <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
                Mencegah misinformasi atau jawaban mengada-ada. Ketika topik berada di luar cakupan AIML, bot mengarahkan mahasiswa dengan panduan kata kunci alternatif atau kontak langsung ke staf BAAK.
              </p>
              
              <div class="mt-6 p-3 bg-amber-950/50 rounded-xl border border-amber-700/40 text-xs text-amber-200 flex items-center space-x-2">
                <i class="fa-solid fa-circle-exclamation text-amber-400 text-base"></i>
                <span>Memenuhi Target Metrik M-02: 100% pertanyaan uji luar cakupan ditangani fallback.</span>
              </div>
            </div>

            <div class="lg:col-span-5 bg-slate-950/80 p-5 rounded-2xl border border-amber-500/30 shadow-inner">
              <div class="text-xs text-slate-400 mb-2 font-mono">// Contoh Pesan Fallback:</div>
              <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800 text-xs text-slate-300 leading-relaxed">
                "Maaf, informasi untuk pertanyaan tersebut belum tersedia di basis pengetahuan kami. Silakan coba kata kunci lain atau hubungi staf BAAK di loket administrasi kampus."
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Feature Grid Cards with Staggered AOS Animations -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Fitur 1: F-01 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:-translate-y-2 hover:shadow-2xl hover:border-indigo-500/50 transition-all duration-300 group flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80" 
              alt="Pencocokan Pola AIML" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
            <span class="absolute bottom-3 left-4 px-2.5 py-1 text-[11px] font-bold bg-indigo-600 text-white rounded-md shadow">
              Fitur F-01 (Must)
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">Pencocokan Pola Pertanyaan AIML</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Mencocokkan pertanyaan yang diketik mahasiswa dengan basis pengetahuan aturan akademik secara tepat dan menghasilkan jawaban yang konsisten.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200 flex items-center text-xs font-semibold text-indigo-600">
              <span>Sesuai User Story US-01</span>
              <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            </div>
          </div>
        </div>

        <!-- Fitur 2: F-02 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:-translate-y-2 hover:shadow-2xl hover:border-purple-500/50 transition-all duration-300 group flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=600&q=80" 
              alt="Shortcut Pertanyaan Populer" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
