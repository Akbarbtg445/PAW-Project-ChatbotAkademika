  <!-- Section: Live API Endpoint Tester -->
  <section id="api-tester" class="py-24 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          REST API & Middleware Logger
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Pengujian Endpoint Langsung</h2>
        <p class="text-slate-600 text-sm mt-3 leading-relaxed">
          Uji endpoint backend secara langsung melalui <strong>Browser Interactive Tester</strong> maupun link <strong>Raw JSON</strong>. Setiap request akan otomatis diproses dan dicatat oleh <strong>Middleware Logger</strong> di terminal console backend.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Card Endpoint 1: GET /api/status -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between" data-aos="fade-right" data-aos-duration="700">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div class="flex items-center space-x-2">
                <span class="px-2.5 py-1 text-xs font-black bg-emerald-600 text-white rounded-md shadow-sm">GET</span>
                <code class="text-sm font-bold text-slate-800">/api/status</code>
              </div>
              <div class="flex items-center space-x-2">
                <!-- Direct link for raw JSON (Open in new tab) -->
                <a 
                  href="/api/status" 
                  target="_blank" 
                  class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold rounded-lg transition-all flex items-center space-x-1"
                  title="Buka response JSON mentah di tab baru"
                >
                  <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
                  <span>Buka Raw URL</span>
                </a>
                <button 
                  onclick="testApi('/api/status', 'status-output', 'status-badge')"
                  class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-all flex items-center space-x-1.5 shadow active:scale-95"
                >
                  <i class="fa-solid fa-play text-[10px]"></i>
                  <span>Kirim Request</span>
                </button>
              </div>
            </div>
            
            <p class="text-xs text-slate-500 mb-3">
              Mengembalikan status kesehatan server, waktu aktif (uptime), dan versi aplikasi Chatbot Akademika.
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span class="font-medium">Response JSON:</span>
              <span id="status-badge" class="font-medium text-slate-400">Belum diuji</span>
            </div>
          </div>

          <pre id="status-output" class="bg-slate-900 text-emerald-400 p-4 rounded-xl text-xs overflow-x-auto h-52 font-mono leading-relaxed shadow-inner">// Klik "Kirim Request" untuk menguji langsung di sini,
// atau klik "Buka Raw URL" untuk membukanya di tab baru.</pre>
        </div>

        <!-- Card Endpoint 2: GET /api/produk -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between" data-aos="fade-left" data-aos-duration="700">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div class="flex items-center space-x-2">
                <span class="px-2.5 py-1 text-xs font-black bg-emerald-600 text-white rounded-md shadow-sm">GET</span>
                <code class="text-sm font-bold text-slate-800">/api/produk</code>
              </div>
              <div class="flex items-center space-x-2">
                <!-- Direct link for raw JSON (Open in new tab) -->
                <a 
                  href="/api/produk" 
                  target="_blank" 
                  class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold rounded-lg transition-all flex items-center space-x-1"
                  title="Buka response JSON mentah di tab baru"
                >
                  <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
                  <span>Buka Raw URL</span>
                </a>
                <button 
                  onclick="testApi('/api/produk', 'produk-output', 'produk-badge')"
                  class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-all flex items-center space-x-1.5 shadow active:scale-95"
                >
                  <i class="fa-solid fa-play text-[10px]"></i>
                  <span>Kirim Request</span>
                </button>
              </div>
            </div>
            
            <p class="text-xs text-slate-500 mb-3">
              Mengembalikan data katalog modul dan layanan akademik dalam bentuk array JSON yang valid.
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span class="font-medium">Response JSON:</span>
              <span id="produk-badge" class="font-medium text-slate-400">Belum diuji</span>
            </div>
          </div>

          <pre id="produk-output" class="bg-slate-900 text-emerald-400 p-4 rounded-xl text-xs overflow-x-auto h-52 font-mono leading-relaxed shadow-inner">// Klik "Kirim Request" untuk menguji langsung di sini,
// atau klik "Buka Raw URL" untuk membukanya di tab baru.</pre>
        </div>

      </div>

      <!-- Panduan Pengujian Terminal / Postman -->
      <div class="mt-8 bg-indigo-50/70 border border-indigo-200 rounded-2xl p-6" data-aos="fade-up" data-aos-duration="700">
        <h4 class="text-sm font-bold text-indigo-900 flex items-center">
          <i class="fa-solid fa-terminal mr-2 text-indigo-600"></i>
          Catatan Verifikasi Middleware Logger di Terminal:
        </h4>
        <p class="text-xs text-indigo-800 mt-1 leading-relaxed">
          Ketika tombol <strong>"Kirim Request"</strong> atau link <strong>"Buka Raw URL"</strong> diakses, perhatikan terminal backend tempat server Node.js berjalan. Middleware logger akan otomatis mencetak log seperti berikut:
        </p>
        <div class="mt-3 bg-slate-900 text-slate-200 p-3 rounded-xl font-mono text-xs overflow-x-auto">
          [2026-11-06T15:52:52.989Z] [GET] /api/status - Status: 200 (4ms)<br/>
          [2026-11-06T15:53:10.120Z] [GET] /api/produk - Status: 200 (3ms)
        </div>
      </div>
    </div>
  </section>

