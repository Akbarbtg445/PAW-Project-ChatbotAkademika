  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-sm">
          <i class="fa-solid fa-robot"></i>
        </div>
        <span class="font-bold text-white text-base"><%= appName %></span>
        <span class="text-slate-500">| PAW Week 7 Integration Project</span>
      </div>
      <p class="text-xs text-slate-400 text-center md:text-right">
        Dibangun dengan Node.js, Express.js (MVC), EJS, Tailwind CSS CDN & REST API.
      </p>
    </div>
  </footer>

  <!-- Frontend Logic Scripts -->
  <script>
    // Knowledge Base sederhana sesuai PRD (US-01, US-02, US-03)
    const knowledgeBase = [
      {
        patterns: ["krs", "isi krs", "alur krs", "pengisian krs"],
        answer: "Alur pengisian KRS: 1) Login ke SIAKAD, 2) Pastikan tagihan SPP semester telah lunas, 3) Pilih menu 'KRS Online', 4) Ambil mata kuliah sesuai semester & prasyarat, 5) Klik ajukan dan minta persetujuan Dosen Pembimbing Akademik (DPA)."
      },
      {
        patterns: ["jadwal", "kalender", "ukt", "revisi krs", "batas pembayaran"],
        answer: "Berdasarkan Kalender Akademik: Batas pembayaran UKT berlangsung hingga minggu ke-2 semester. Revisi KRS (tambah/batal matkul) dibuka selama 5 hari kerja setelah masa perkuliahan dimulai."
      },
      {
        patterns: ["bebas pustaka", "perpustakaan", "skripsi", "plagiasi", "turnitin"],
        answer: "Syarat bebas pustaka: 1) Tidak memiliki tunggakan pinjaman buku, 2) Menyerahkan softcopy file skripsi format PDF & docx, 3) Bukti lolos uji Turnitin maksimal similarity 20%."
      },
      {
        patterns: ["yudisium", "wisuda", "ijazah", "daftar yudisium"],
        answer: "Prosedur pendaftaran Yudisium: Lengkapi berkas bebas pustaka, transkrip nilai final tanpa nilai E, bukti skor TOEFL/TOEP min. 450, dan unggah formulir pendaftaran melalui loket BAAK."
      }
    ];

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('user-input');
      const text = input.value.trim();
      if (!text) return;

      appendChatMessage('user', text);
      input.value = '';

      // Tampilkan indikator respon cepat < 3 detik sesuai PRD M-01
      setTimeout(() => {
        const reply = findAnswer(text);
        appendChatMessage('bot', reply);
      }, 500);
    }

    function sendQuickQuestion(questionText) {
      appendChatMessage('user', questionText);
      setTimeout(() => {
        const reply = findAnswer(questionText);
        appendChatMessage('bot', reply);
      }, 500);
    }

    function findAnswer(query) {
      const lower = query.toLowerCase();
      for (const item of knowledgeBase) {
        if (item.patterns.some(pattern => lower.includes(pattern))) {
          return item.answer;
        }
      }
      // Fallback message sesuai PRD (US-03 / F-03)
      return "Maaf, informasi untuk pertanyaan tersebut belum tersedia di basis pengetahuan kami. Silakan coba kata kunci lain atau hubungi staf BAAK di loket layanan administrasi kampus.";
    }

    function appendChatMessage(sender, text) {
      const box = document.getElementById('chat-box');
      const wrapper = document.createElement('div');
      wrapper.className = `flex items-start space-x-3 ${sender === 'user' ? 'justify-end' : ''}`;

      if (sender === 'user') {
        wrapper.innerHTML = `
          <div class="bg-indigo-600 text-white p-3.5 rounded-2xl rounded-tr-none shadow-sm max-w-md text-sm leading-relaxed">
            ${text}
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex-shrink-0 flex items-center justify-center text-xs font-bold shadow">
            <i class="fa-solid fa-user"></i>
          </div>
        `;
      } else {
        wrapper.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow">
            <i class="fa-solid fa-robot"></i>
          </div>
          <div class="bg-white border border-slate-200 p-3.5 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700 leading-relaxed">
            ${text}
          </div>
        `;
      }

      box.appendChild(wrapper);
      box.scrollTop = box.scrollHeight;
    }

    // Fungsi Pengujian REST API
    async function testApi(url, outputId, badgeId) {
      const outputElem = document.getElementById(outputId);
      const badgeElem = document.getElementById(badgeId);

      badgeElem.innerHTML = `<span class="text-amber-500 font-semibold"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Mengirim Request...</span>`;
      outputElem.innerText = "// Mengirim HTTP GET request ke " + url + "...";

      const t0 = performance.now();
      try {
        const res = await fetch(url);
        const t1 = performance.now();
        const duration = Math.round(t1 - t0);
        const data = await res.json();

        badgeElem.innerHTML = `<span class="text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200"><i class="fa-solid fa-circle-check mr-1"></i>${res.status} OK (${duration}ms)</span>`;
        outputElem.innerText = JSON.stringify(data, null, 2);
      } catch (err) {
        badgeElem.innerHTML = `<span class="text-rose-600 font-bold bg-rose-50 px-2 py-0.5 rounded border border-rose-200">Error</span>`;
        outputElem.innerText = `Error: ${err.message}`;
      }
    }
  </script>
</body>
</html>
