<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-indigo-200 group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-robot text-lg"></i>
        </div>
        <div>
          <span class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-indigo-600 transition-colors"><%= appName %></span>
          <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-xs font-semibold bg-indigo-100 text-indigo-700 rounded-full">v<%= appVersion %></span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-slate-600">
        <a href="#fitur" class="hover:text-indigo-600 transition">Fitur Utama</a>
        <a href="#produk" class="hover:text-indigo-600 transition">Katalog Layanan</a>
        <a href="#persona" class="hover:text-indigo-600 transition">Target Pengguna</a>
        <a href="#chat-demo" class="hover:text-indigo-600 transition">Demo Chatbot</a>
        <a href="#api-tester" class="hover:text-indigo-600 transition">Uji REST API</a>
        <a href="#tim" class="hover:text-indigo-600 transition">Tim Pengembang</a>
      </nav>

      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
          <span class="w-2 h-2 mr-2 bg-emerald-500 rounded-full animate-pulse"></span>
          Server Online (Port 3000)
        </span>
      </div>
    </div>
  </header>

  <!-- Hero Section with Visual Imagery -->
  <section class="relative overflow-hidden pt-12 pb-20 md:py-24 bg-gradient-to-br from-indigo-50/80 via-white to-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Content -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 mb-6 text-xs font-semibold text-indigo-700 bg-indigo-100/90 rounded-full border border-indigo-200">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>PAW Week 7: Integrasi Frontend, REST API & Logger</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
            Asisten Pintar <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600">
              Informasi Akademik
            </span> Kampus
          </h1>

          <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            Solusi cepat dan terpusat bagi mahasiswa untuk menemukan informasi jadwal, kalender akademik, KRS, dan prosedur administrasi BAAK secara instan tanpa antrean.
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-4">
            <a href="#chat-demo" class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-lg shadow-indigo-200 transition-all flex items-center space-x-2">
              <i class="fa-solid fa-comments"></i>
              <span>Coba Demo Chatbot</span>
            </a>
            <a href="#api-tester" class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-semibold border border-slate-300 shadow-sm transition-all flex items-center space-x-2">
              <i class="fa-solid fa-code"></i>
              <span>Uji Endpoint REST API</span>
            </a>
          </div>

          <!-- Quick Metrics Bar (from PRD) -->
          <div class="mt-10 pt-8 border-t border-slate-200/80 grid grid-cols-3 gap-4 text-center lg:text-left">
            <div>
              <p class="text-2xl font-black text-indigo-600">&lt; 3 Detik</p>
              <p class="text-xs text-slate-500 font-medium mt-0.5">Target Respon Jawaban</p>
            </div>
            <div>
              <p class="text-2xl font-black text-indigo-600">100%</p>
              <p class="text-xs text-slate-500 font-medium mt-0.5">Penanganan Fallback</p>
            </div>
            <div>
              <p class="text-2xl font-black text-indigo-600">24/7</p>
              <p class="text-xs text-slate-500 font-medium mt-0.5">Akses Mandiri Mahasiswa</p>
            </div>
          </div>
        </div>

        <!-- Right Hero Visual Graphic -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Decorative Glow Background -->
            <div class="absolute -inset-2 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-3xl blur-2xl opacity-20 transform -rotate-1"></div>
            
            <!-- Hero Image Card -->
            <div class="relative bg-white p-3 rounded-3xl shadow-2xl border border-slate-100 overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80" 
                alt="Mahasiswa berkonsultasi akademik" 
                class="w-full h-80 object-cover rounded-2xl"
              />
              
              <!-- Floating Badge 1: Bot Response -->
              <div class="absolute top-6 left-6 bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl shadow-lg border border-slate-100 flex items-center space-x-2.5 animate-bounce" style="animation-duration: 4s;">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs">
                  <i class="fa-solid fa-robot"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-800">Alur KRS & Kalender</p>
                  <p class="text-[10px] text-emerald-600 font-semibold flex items-center">
                    <i class="fa-solid fa-check-circle mr-1"></i> Terverifikasi BAAK
                  </p>
                </div>
              </div>

              <!-- Floating Badge 2: Quick Status -->
              <div class="absolute bottom-6 right-6 bg-slate-900/90 backdrop-blur-md px-4 py-2.5 rounded-xl shadow-lg text-white flex items-center space-x-2">
                <span class="w-2.5 h-2.5 bg-emerald-400 rounded-full animate-ping"></span>
                <p class="text-xs font-medium">Asisten Aktif &bull; Siap Menjawab</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Fitur Utama (id="fitur" - Sesuai PRD F-01, F-02, F-03) -->
  <section id="fitur" class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          Fitur & Spesifikasi PRD
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          Solusi Terarah Berdasarkan Kebutuhan Akademik
        </h2>
        <p class="text-slate-600 text-base mt-3">
          Dirancang untuk memecahkan masalah informasi yang tersebar dan mengurangi beban pertanyaan berulang pada bagian tata usaha kampus.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Fitur 1: F-01 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80" 
              alt="Pencocokan Pola AIML" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
            <span class="absolute bottom-3 left-4 px-2.5 py-1 text-[11px] font-bold bg-indigo-600 text-white rounded-md shadow">
              Fitur F-01 (Must)
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">Pencocokan Pola Pertanyaan AIML</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Mencocokkan pertanyaan yang diketik mahasiswa dengan basis pengetahuan aturan akademik secara tepat dan menghasilkan jawaban yang konsisten.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200 flex items-center text-xs font-semibold text-indigo-600">
              <span>Sesuai User Story US-01</span>
              <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            </div>
          </div>
        </div>

        <!-- Fitur 2: F-02 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=600&q=80" 
              alt="Shortcut Pertanyaan Populer" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
            <span class="absolute bottom-3 left-4 px-2.5 py-1 text-[11px] font-bold bg-purple-600 text-white rounded-md shadow">
              Fitur F-02 (Should)
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">Shortcut Pertanyaan Populer</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Menyediakan tombol pertanyaan cepat seputar KRS, kalender akademik, dan yudisium agar mahasiswa baru dapat langsung memulai tanpa merangkai kalimat.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200 flex items-center text-xs font-semibold text-purple-600">
              <span>Sesuai User Story US-02</span>
              <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            </div>
          </div>
        </div>

        <!-- Fitur 3: F-03 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=600&q=80" 
              alt="Pesan Fallback Cerdas" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent"></div>
            <span class="absolute bottom-3 left-4 px-2.5 py-1 text-[11px] font-bold bg-amber-600 text-white rounded-md shadow">
              Fitur F-03 (Must)
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">Pesan Fallback & Eskalasi BAAK</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Memberikan notifikasi ramah dan saran langkah berikutnya ketika pertanyaan mahasiswa di luar basis data, mencegah asumsi informasi keliru.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200 flex items-center text-xs font-semibold text-amber-600">
              <span>Sesuai User Story US-03</span>
              <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Target User / Persona (PRD Section 4) -->
  <section id="persona" class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600">Persona & Stakeholder</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">Target Pengguna Aplikasi</h2>
        <p class="text-slate-500 text-sm mt-2">Disesuaikan dengan analisis kebutuhan pengguna pada dokumen PRD.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Persona 1 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-start space-x-5">
          <img 
            src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=200&q=80" 
            alt="Dimas Gonjales" 
            class="w-20 h-20 rounded-2xl object-cover shadow-md flex-shrink-0"
          />
          <div>
            <span class="px-2.5 py-0.5 text-xs font-semibold bg-indigo-100 text-indigo-700 rounded-full">Mahasiswa</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1">Dimas Gonjales</h3>
            <p class="text-xs text-slate-500 mt-0.5 mb-2">Mahasiswa Aktif Fakultas Ilmu Komputer</p>
            <p class="text-sm text-slate-600 leading-relaxed">
              <strong>Kebutuhan Utama:</strong> Memperoleh jawaban instan, pasti, dan akurat mengenai alur pengisian KRS, jadwal revisi, dan syarat administrasi tanpa harus mengantre di loket kampus.
            </p>
          </div>
        </div>

        <!-- Persona 2 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-start space-x-5">
          <img 
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80" 
            alt="Supri Sunandar" 
            class="w-20 h-20 rounded-2xl object-cover shadow-md flex-shrink-0"
          />
          <div>
            <span class="px-2.5 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full">Staf BAAK</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1">Supri Sunandar</h3>
            <p class="text-xs text-slate-500 mt-0.5 mb-2">Staf Layanan Administrasi Akademik</p>
            <p class="text-sm text-slate-600 leading-relaxed">
              <strong>Kebutuhan Utama:</strong> Membutuhkan sistem otomatis untuk menyaring pertanyaan umum mahasiswa serta panel informasi yang dapat diperbarui dengan mudah tanpa memodifikasi kode program.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Chatbot Demo Preview -->
  <section id="chat-demo" class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          Simulasi Interaktif Mahasiswa
        </span>
        <h2 class="text-3xl font-bold text-slate-900 mt-3">Pratinjau Percakapan Chatbot Akademika</h2>
        <p class="text-slate-500 text-sm mt-2">Mendukung pengiriman pertanyaan teks bebas serta pemilihan tombol shortcut pertanyaan populer.</p>
      </div>

      <!-- Chat Container -->
      <div class="bg-slate-50 rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
        <!-- Chat Header -->
        <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white px-6 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div>
              <h3 class="font-semibold text-sm">Bot Akademika BAAK</h3>
              <p class="text-xs text-indigo-200 flex items-center">
                <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-ping"></span> Respons Cepat (&lt; 3 Detik)
              </p>
            </div>
          </div>
          <span class="text-xs bg-indigo-800/60 px-3 py-1 rounded-full border border-indigo-400/30">AIML Engine Ready</span>
        </div>

        <!-- Chat Messages Box -->
        <div id="chat-box" class="p-6 space-y-4 h-80 overflow-y-auto">
          <!-- Bot Welcome Message -->
          <div class="flex items-start space-x-3">
            <div class="w-9 h-9 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-sm shadow">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700 leading-relaxed">
              Halo! Saya <strong>Chatbot Akademika</strong>. Saya dapat membantu memberikan panduan terkait pengisian KRS, kalender akademik, jadwal pembayaran UKT, syarat skripsi, dan verifikasi yudisium. Ada yang ingin Anda tanyakan?
            </div>
          </div>
        </div>

        <!-- Popular Questions / Shortcuts (PRD US-02 / F-02) -->
        <div class="px-6 py-3 bg-indigo-50/80 border-t border-slate-200">
          <p class="text-xs font-semibold text-slate-600 mb-2 flex items-center">
            <i class="fa-solid fa-bolt text-indigo-500 mr-1.5"></i> Klik Pilihan Pertanyaan Populer:
          </p>
          <div class="flex flex-wrap gap-2">
            <% popularQuestions.forEach(question => { %>
              <button onclick="sendQuickQuestion('<%= question %>')" class="text-xs bg-white hover:bg-indigo-600 hover:text-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 transition-colors shadow-sm">
                <%= question %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white border-t border-slate-200">
          <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex space-x-3">
            <input 
              type="text" 
              id="user-input" 
              placeholder="Ketik pertanyaan akademik Anda di sini (misal: syarat yudisium, batas ukt)..." 
              class="flex-1 px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            />
            <button 
              type="submit" 
              class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition flex items-center space-x-2 shadow"
            >
              <span>Kirim</span>
              <i class="fa-solid fa-paper-plane text-xs"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Data Produk / Layanan Akademik (Dynamic from Backend MVC) -->
  <section id="produk" class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-100/70 px-3 py-1 rounded-full">
          Model Data Backend (MVC)
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Katalog Modul Layanan Akademika</h2>
        <p class="text-slate-600 text-sm mt-2">
          Data berikut dikelola dan dirender langsung dari Model Express.js (<code class="bg-indigo-100/80 text-indigo-800 px-1.5 py-0.5 rounded text-xs font-mono">models/productModel.js</code>).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% products.forEach(product => { %>
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            
            <div>
              <!-- Visual Image for each product -->
              <div class="h-44 overflow-hidden relative">
                <img 
                  src="<%= product.gambar %>" 
                  alt="<%= product.nama %>" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
                <span class="absolute top-3 right-3 px-2.5 py-1 text-xs font-semibold rounded-full bg-white/90 backdrop-blur-md text-slate-700 shadow-sm">
                  <%= product.kategori %>
                </span>
                <div class="absolute bottom-3 left-4 text-white flex items-center space-x-2">
                  <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-sm shadow">
                    <i class="fa-solid <%= product.ikon %>"></i>
                  </div>
                  <span class="text-xs font-semibold drop-shadow">ID #<%= product.id %></span>
                </div>
              </div>

              <!-- Product Details -->
              <div class="p-6">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-2">
                  <%= product.nama %>
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  <%= product.deskripsi %>
                </p>
              </div>
            </div>
            
            <div class="p-6 pt-0 border-t border-slate-100 mt-auto flex items-center justify-between text-xs">
              <span class="font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                <i class="fa-solid fa-circle-check mr-1"></i> <%= product.tipe %>
              </span>
