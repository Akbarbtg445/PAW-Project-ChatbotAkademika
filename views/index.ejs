<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- AOS (Animate On Scroll) CDN -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <style>
    @keyframes chatSlideUp {
      from { opacity: 0; transform: translateY(12px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .chat-bubble-enter {
      animation: chatSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .feature-tab-btn.active {
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      color: #ffffff;
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.5);
      border-color: transparent;
    }
    .tab-content-enter {
      animation: featureFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes featureFadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-robot text-lg"></i>
        </div>
        <div>
          <span class="font-bold text-lg text-white tracking-tight group-hover:text-indigo-400 transition-colors"><%= appName %></span>
          <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-xs font-semibold bg-indigo-900/80 text-indigo-300 border border-indigo-700/50 rounded-full">v<%= appVersion %></span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-slate-300">
        <a href="#fitur" class="hover:text-white transition">Fitur Utama</a>
        <a href="#chat-demo" class="hover:text-white transition">Demo Chatbot</a>
        <a href="#faq-crud" class="hover:text-white transition text-indigo-400 font-semibold">Kelola FAQ (CRUD)</a>
        <a href="#api-tester" class="hover:text-white transition">Uji REST API</a>
        <a href="#tim" class="hover:text-white transition">Tim Pengembang</a>
      </nav>

      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-950/80 text-indigo-300 border border-indigo-700/60 shadow-sm hidden sm:inline-flex">
          <span class="w-2 h-2 mr-2 bg-indigo-400 rounded-full animate-pulse"></span>
          Gemini AI & PostgreSQL
        </span>
        <a href="/login" class="inline-flex items-center px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-600/30 transition">
          <i class="fa-solid fa-user-shield text-xs mr-1.5"></i>
          <span>Login Admin</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[85vh] flex items-center justify-center border-b border-slate-800">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=2000&q=80" 
        alt="University Campus" 
        class="w-full h-full object-cover object-center scale-105 filter brightness-90 contrast-105"
      />
      <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 45%, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.85) 60%, rgba(2, 6, 23, 0.98) 100%);"></div>
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(2, 6, 23, 0.95) 0%, rgba(2, 6, 23, 0.3) 25%, rgba(2, 6, 23, 0.6) 70%, rgba(2, 6, 23, 1) 100%);"></div>
      <div class="absolute inset-0 opacity-15 bg-[linear-gradient(to_right,#6366f1_1px,transparent_1px),linear-gradient(to_bottom,#6366f1_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 mb-8 text-xs font-bold text-indigo-300 bg-indigo-950/80 rounded-full border border-indigo-700/60 shadow-xl backdrop-blur-md">
        <i class="fa-solid fa-wand-magic-sparkles text-indigo-400"></i>
        <span>PAW CONTINUOUS PROJECT &bull; POSTGRESQL + GOOGLE GEMINI AI</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-tight drop-shadow-2xl">
        Informasi Akademik & KRS <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-indigo-300 to-purple-400">
          Tanpa Batas Waktu.
        </span>
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed drop-shadow">
        Tanyakan jadwal kuliah, alur KRS, kalender akademik, dan berkas administrasi BAAK kapan saja. Seluruh basis pengetahuan terintegrasi langsung dengan database PostgreSQL.
      </p>

      <div class="mt-10 max-w-2xl mx-auto">
        <form onsubmit="handleHeroSearch(event)" class="flex flex-col sm:flex-row gap-2.5 p-2 bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-700/80 shadow-2xl focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/30 transition-all">
          <div class="flex-1 flex items-center px-4 py-2">
            <i class="fa-solid fa-magnifying-glass text-slate-400 mr-3"></i>
            <input 
              type="text" 
              id="hero-input"
              placeholder="Contoh: Kapan jadwal pengisian KRS? Bagaimana cara keringanan UKT?" 
              class="w-full bg-transparent text-white placeholder-slate-400 text-sm focus:outline-none"
            />
          </div>
          <button 
            type="submit" 
            class="px-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/40 transition-all flex items-center justify-center space-x-2 group flex-shrink-0"
          >
            <span>Mulai Tanya</span>
            <i class="fa-solid fa-chevron-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Section: Fitur Utama -->
  <section id="fitur" class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          Fitur & Spesifikasi PRD
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          Arsitektur Chatbot Akademika
        </h2>

        <div class="mt-8 inline-flex p-1.5 bg-slate-100 rounded-2xl border border-slate-200 flex-wrap justify-center gap-1.5">
          <button onclick="switchFeatureTab(1)" id="tab-btn-1" class="feature-tab-btn active px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600">
            <i class="fa-solid fa-brain"></i>
            <span>F-01: Pencocokan Pola</span>
          </button>
          <button onclick="switchFeatureTab(2)" id="tab-btn-2" class="feature-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600">
            <i class="fa-solid fa-bolt"></i>
            <span>F-02: Shortcut Populer</span>
          </button>
          <button onclick="switchFeatureTab(3)" id="tab-btn-3" class="feature-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-slate-600">
            <i class="fa-solid fa-database"></i>
            <span>F-03: Manajemen FAQ Database</span>
          </button>
        </div>
      </div>

      <div class="max-w-5xl mx-auto" data-aos="fade-up">
        <div id="tab-pane-1" class="tab-pane tab-content-enter bg-gradient-to-br from-indigo-900 to-slate-900 text-white rounded-3xl p-8 shadow-xl">
          <span class="px-3 py-1 bg-indigo-500/30 text-indigo-300 text-xs font-bold rounded-full border border-indigo-400/30">Fitur Inti</span>
          <h3 class="text-2xl font-extrabold text-white mt-3">Mesin Pencocokan Kata Kunci Berbasis Database</h3>
          <p class="mt-3 text-slate-300 text-sm leading-relaxed">
            Chatbot memindai kata kunci dari pertanyaan mahasiswa dan mencocokkannya secara dinamis dengan baris data yang tersimpan di tabel <code>faq_akademik</code> PostgreSQL.
          </p>
        </div>

        <div id="tab-pane-2" class="tab-pane hidden tab-content-enter bg-gradient-to-br from-purple-900 to-slate-900 text-white rounded-3xl p-8 shadow-xl">
          <span class="px-3 py-1 bg-purple-500/30 text-purple-300 text-xs font-bold rounded-full border border-purple-400/30">Akses Instan</span>
          <h3 class="text-2xl font-extrabold text-white mt-3">Shortcut Pertanyaan Populer</h3>
          <p class="mt-3 text-slate-300 text-sm leading-relaxed">
            Tombol pertanyaan cepat pada demo chatbot ditarik langsung dari daftar pertanyaan terbaru di database PostgreSQL.
          </p>
        </div>

        <div id="tab-pane-3" class="tab-pane hidden tab-content-enter bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 text-white rounded-3xl p-8 shadow-xl">
          <span class="px-3 py-1 bg-emerald-500/30 text-emerald-300 text-xs font-bold rounded-full border border-emerald-400/30">Full CRUD Integration</span>
          <h3 class="text-2xl font-extrabold text-white mt-3">Pengelolaan Knowledge Base oleh Staf BAAK</h3>
          <p class="mt-3 text-slate-300 text-sm leading-relaxed">
            Staf BAAK dapat menambah, memperbarui, dan menghapus daftar FAQ langsung dari antarmuka web melalui endpoint REST API (<code>GET</code>, <code>POST</code>, <code>PUT</code>, <code>DELETE</code>).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Chatbot Demo Preview (Terhubung ke Google Gemini AI & PostgreSQL) -->
  <section id="chat-demo" class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-100/70 px-3 py-1 rounded-full">
          AI Assistant &bull; Google Gemini LLM
        </span>
        <h2 class="text-3xl font-extrabold text-slate-900 mt-3">Percakapan AI Assistant Akademika</h2>
        <p class="text-slate-500 text-sm mt-2">Ditenagai model <strong>Google Gemini</strong> dengan pembatasan berbasis konteks langsung dari tabel <code>faq_akademik</code> di database PostgreSQL.</p>
      </div>

      <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden" data-aos="zoom-in">
        <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-purple-700 text-white px-6 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div>
              <h3 class="font-semibold text-sm">AI Assistant Akademika BAAK</h3>
              <p class="text-xs text-indigo-200 flex items-center">
                <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-ping"></span> Live Gemini AI & Knowledge Base
              </p>
            </div>
          </div>
          <span class="text-xs bg-indigo-900/60 px-3 py-1 rounded-full border border-indigo-400/30" id="chat-kb-count">
            <%= faqs.length %> Topik Basis Pengetahuan
          </span>
        </div>

        <div id="chat-box" class="p-6 space-y-4 h-96 overflow-y-auto bg-slate-50">
          <div class="flex items-start space-x-3 chat-bubble-enter">
            <div class="w-9 h-9 rounded-full bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center text-sm shadow">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700 leading-relaxed">
              Halo! Saya <strong>AI Assistant Chatbot Akademika</strong>. Saya siap membantu menjawab pertanyaan seputar jadwal perkuliahan, alur pengisian KRS, kalender akademik, dan administrasi BAAK kampus berdasarkan data resmi database kami. Silakan ketik pertanyaan Anda!
            </div>
          </div>
        </div>

        <!-- Shortcut Pertanyaan Populer dari Database -->
        <div class="px-6 py-3 bg-indigo-50/80 border-t border-slate-200">
          <p class="text-xs font-semibold text-slate-600 mb-2 flex items-center">
            <i class="fa-solid fa-bolt text-indigo-500 mr-1.5"></i> Pertanyaan Cepat:
          </p>
          <div id="chat-shortcuts" class="flex flex-wrap gap-2">
            <% popularQuestions.forEach(question => { %>
              <button onclick="sendQuickQuestion('<%= question.replace(/'/g, "\\'") %>')" class="text-xs bg-white hover:bg-indigo-600 hover:text-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 transition-all duration-200 shadow-sm">
                <%= question %>
              </button>
            <% }) %>
          </div>
        </div>

        <div class="p-4 bg-white border-t border-slate-200">
          <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex space-x-3">
            <input 
              type="text" 
              id="user-input" 
              placeholder="Tanyakan jadwal kuliah, alur KRS, UKT, atau administrasi BAAK..." 
              class="flex-1 px-4 py-2.5 text-sm text-slate-800 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500"
              maxlength="1000"
              required
            />
            <button 
              type="submit" 
              id="btn-send-chat"
              class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-400 text-white text-sm font-semibold rounded-xl transition-all flex items-center space-x-2 shadow"
            >
              <span id="btn-send-text">Kirim</span>
              <i id="btn-send-icon" class="fa-solid fa-paper-plane text-xs"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION BARU: Manajemen Knowledge Base FAQ (FULL CRUD FRONTEND <-> POSTGRESQL) -->
  <section id="faq-crud" class="py-24 bg-white border-b border-slate-200 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
          Integrasi Database PostgreSQL (CRUD)
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">
          Manajemen Knowledge Base FAQ Akademik
        </h2>
        <p class="text-slate-600 text-sm mt-2">
          Tambah, lihat, ubah, dan hapus data FAQ secara langsung. Seluruh perubahan disimpan ke PostgreSQL melalui endpoint <code>/api/faq</code>.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Form Tambah / Edit FAQ (Create & Update) -->
        <div class="lg:col-span-5 bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm sticky top-24">
          <div class="flex items-center justify-between mb-5">
            <h3 id="form-title" class="text-lg font-bold text-slate-900 flex items-center">
              <i class="fa-solid fa-circle-plus text-indigo-600 mr-2"></i>
              Tambah Data FAQ Baru
            </h3>
            <span id="form-mode-badge" class="px-2.5 py-0.5 text-xs font-semibold bg-indigo-100 text-indigo-700 rounded-full">
              POST /api/faq
            </span>
          </div>

          <form id="faq-form" onsubmit="handleFaqSubmit(event)" class="space-y-4">
            <input type="hidden" id="faq-id" value="">

            <div>
              <label for="faq-kategori" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Kategori Layanan
              </label>
              <input 
                type="text" 
                id="faq-kategori" 
                required
                placeholder="Contoh: KRS, UKT, Wisuda, Perpustakaan"
                class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900"
              />
            </div>

            <div>
              <label for="faq-pertanyaan" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Pertanyaan Mahasiswa
              </label>
              <input 
                type="text" 
                id="faq-pertanyaan" 
                required
                placeholder="Contoh: Kapan batas akhir pembayaran UKT?"
                class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900"
              />
            </div>

            <div>
              <label for="faq-jawaban" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Jawaban Resmi BAAK
              </label>
              <textarea 
                id="faq-jawaban" 
                rows="4" 
                required
                placeholder="Tuliskan jawaban lengkap dan akurat dari BAAK..."
                class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900"
              ></textarea>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button 
                type="submit" 
                id="btn-submit-faq"
                class="flex-1 py-3 px-5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2"
              >
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Simpan ke Database</span>
              </button>
              <button 
                type="button" 
                id="btn-cancel-edit" 
                onclick="resetFaqForm()"
                class="hidden py-3 px-4 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-xl transition-all"
              >
                Batal
              </button>
            </div>
          </form>

          <!-- Notifikasi Status CRUD -->
          <div id="crud-alert" class="hidden mt-4 p-3 rounded-xl text-xs font-medium"></div>
        </div>

        <!-- Daftar Data FAQ dari PostgreSQL (Read & Delete) -->
        <div class="lg:col-span-7">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-900">
              Daftar Data di PostgreSQL (<span id="faq-total-count"><%= faqs.length %></span>)
            </h3>
            <button 
              onclick="fetchFaqs()" 
              class="px-3 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg border border-slate-300 transition flex items-center space-x-1.5"
            >
              <i class="fa-solid fa-rotate"></i>
              <span>Refresh Data</span>
            </button>
          </div>

          <div id="faq-list-container" class="space-y-4">
            <% if (faqs.length === 0) { %>
              <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-300 text-slate-500 text-sm">
                Belum ada data FAQ di database. Silakan tambahkan data melalui form di samping.
              </div>
            <% } else { %>
              <% faqs.forEach(item => { %>
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 hover:border-indigo-400 transition-all shadow-sm">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex items-center space-x-2 mb-2">
                        <span class="px-2.5 py-0.5 text-xs font-bold bg-indigo-100 text-indigo-700 rounded-md">
                          <%= item.kategori %>
                        </span>
                        <span class="text-xs text-slate-400 font-mono">ID #<%= item.id %></span>
                      </div>
                      <h4 class="text-base font-bold text-slate-900 mb-1.5"><%= item.pertanyaan %></h4>
                      <p class="text-sm text-slate-600 leading-relaxed"><%= item.jawaban %></p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-2 flex-shrink-0">
                      <button 
                        onclick="editFaq(<%= item.id %>)"
                        class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1 shadow-sm"
                        title="Ubah Data"
                      >
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Edit</span>
                      </button>
                      <button 
                        onclick="deleteFaq(<%= item.id %>)"
                        class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1 shadow-sm"
                        title="Hapus Data"
                      >
                        <i class="fa-solid fa-trash"></i>
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Live API Endpoint Tester -->
  <section id="api-tester" class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-100/70 px-3 py-1 rounded-full">
          REST API & Middleware Logger
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Pengujian Endpoint Langsung</h2>
        <p class="text-slate-600 text-sm mt-2">
          Uji endpoint backend dan pantau log HTTP di terminal backend Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- GET /api/status -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div class="flex items-center space-x-2">
                <span class="px-2.5 py-1 text-xs font-black bg-emerald-600 text-white rounded-md">GET</span>
                <code class="text-sm font-bold text-slate-800">/api/status</code>
              </div>
              <div class="flex items-center space-x-2">
                <button onclick="testApi('/api/status', 'status-output', 'status-badge')" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shadow-sm">
                  Kirim Request
                </button>
              </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span>Response JSON:</span>
              <span id="status-badge" class="text-slate-400">Belum diuji</span>
            </div>
          </div>
          <pre id="status-output" class="bg-slate-900 text-emerald-400 p-4 rounded-xl text-xs overflow-x-auto h-48 font-mono">// Klik "Kirim Request" untuk menguji /api/status</pre>
        </div>

        <!-- GET /api/faq -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div class="flex items-center space-x-2">
                <span class="px-2.5 py-1 text-xs font-black bg-emerald-600 text-white rounded-md">GET</span>
                <code class="text-sm font-bold text-slate-800">/api/faq</code>
              </div>
              <div class="flex items-center space-x-2">
                <button onclick="testApi('/api/faq', 'faq-output', 'faq-badge')" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shadow-sm">
                  Kirim Request
                </button>
              </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span>Response JSON (PostgreSQL):</span>
              <span id="faq-badge" class="text-slate-400">Belum diuji</span>
            </div>
          </div>
          <pre id="faq-output" class="bg-slate-900 text-emerald-400 p-4 rounded-xl text-xs overflow-x-auto h-48 font-mono">// Klik "Kirim Request" untuk mengambil data dari PostgreSQL</pre>
        </div>

        <!-- POST /api/chat (AI Assistant) -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div class="flex items-center space-x-2">
                <span class="px-2.5 py-1 text-xs font-black bg-indigo-600 text-white rounded-md">POST</span>
                <code class="text-sm font-bold text-slate-800">/api/chat</code>
              </div>
              <button onclick="testChatApi()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shadow-sm">
                Kirim Chat
              </button>
            </div>
            <div class="mb-2">
              <input 
                type="text" 
                id="test-chat-input" 
                value="Kapan jadwal pengisian KRS semester baru?" 
                placeholder="Ketik pertanyaan untuk diuji..." 
                class="w-full px-2.5 py-1.5 text-xs text-slate-800 border border-slate-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500"
              />
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span>Response JSON (Gemini AI):</span>
              <span id="chat-badge" class="text-slate-400">Belum diuji</span>
            </div>
          </div>
          <pre id="chat-output" class="bg-slate-900 text-indigo-300 p-4 rounded-xl text-xs overflow-x-auto h-48 font-mono">// Klik "Kirim Chat" untuk menguji endpoint POST /api/chat</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Tim Pengembang -->
  <section id="tim" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-wider font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
          Kolaborasi Kelompok
        </span>
        <h2 class="text-3xl font-bold text-slate-900 mt-3">Tim Pengembang Chatbot Akademika</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% teamMembers.forEach(member => { %>
          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-3.5">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 text-white font-bold flex items-center justify-center text-sm shadow-md flex-shrink-0">
              <%= member.name.charAt(0) %>
            </div>
            <div class="overflow-hidden">
              <h4 class="text-sm font-bold text-slate-800 truncate"><%= member.name %></h4>
              <p class="text-xs text-indigo-600 font-mono font-medium mt-0.5"><%= member.nim %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-10 border-t border-slate-800 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-sm">
          <i class="fa-solid fa-robot"></i>
        </div>
        <span class="font-bold text-white text-base"><%= appName %></span>
        <span class="text-slate-500">| PAW Database & CRUD Integration</span>
      </div>
      <p class="text-xs text-slate-400">
        Node.js, Express.js (MVC), EJS, Tailwind CSS CDN & PostgreSQL.
      </p>
    </div>
  </footer>

  <!-- Frontend Logic Scripts -->
  <script>
    // Data FAQ awal yang dirender dari server (PostgreSQL)
    let faqData = <%- JSON.stringify(faqs) %>;

    document.addEventListener('DOMContentLoaded', () => {
      AOS.init({ duration: 700, once: true });
    });

    function switchFeatureTab(tabIndex) {
      document.querySelectorAll('.tab-pane').forEach(pane => {
        pane.classList.add('hidden');
        pane.classList.remove('tab-content-enter');
      });
      const activePane = document.getElementById(`tab-pane-${tabIndex}`);
      if (activePane) {
        activePane.classList.remove('hidden');
        void activePane.offsetWidth;
        activePane.classList.add('tab-content-enter');
      }
      document.querySelectorAll('.feature-tab-btn').forEach((btn, idx) => {
        btn.classList.toggle('active', idx + 1 === tabIndex);
      });
    }

    // ==========================================
    // 1. LOGIKA CRUD FRONTEND <-> BACKEND API
    // ==========================================

    function showAlert(message, isError = false) {
      const alertBox = document.getElementById('crud-alert');
      alertBox.className = `mt-4 p-3 rounded-xl text-xs font-semibold ${
        isError 
          ? 'bg-rose-100 text-rose-800 border border-rose-200' 
          : 'bg-emerald-100 text-emerald-800 border border-emerald-200'
      }`;
      alertBox.textContent = message;
      alertBox.classList.remove('hidden');
      setTimeout(() => alertBox.classList.add('hidden'), 4000);
    }

    // READ: Ambil seluruh data terbaru dari PostgreSQL via GET /api/faq
    async function fetchFaqs() {
      try {
        const res = await fetch('/api/faq');
        const result = await res.json();
        if (result.status === 'success') {
          faqData = result.data;
          renderFaqList();
          updateChatbotShortcuts();
        }
      } catch (err) {
        showAlert('Gagal memuat data dari server: ' + err.message, true);
      }
    }

    function renderFaqList() {
      const container = document.getElementById('faq-list-container');
      const totalCount = document.getElementById('faq-total-count');
      const kbCount = document.getElementById('chat-kb-count');

      totalCount.textContent = faqData.length;
      kbCount.textContent = `${faqData.length} Topik Aktif`;

      if (faqData.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-300 text-slate-500 text-sm">
            Belum ada data FAQ di database. Silakan tambahkan data melalui form di samping.
          </div>
        `;
        return;
      }

      container.innerHTML = faqData.map(item => `
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 hover:border-indigo-400 transition-all shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center space-x-2 mb-2">
                <span class="px-2.5 py-0.5 text-xs font-bold bg-indigo-100 text-indigo-700 rounded-md">
                  ${escapeHtml(item.kategori)}
                </span>
                <span class="text-xs text-slate-400 font-mono">ID #${item.id}</span>
              </div>
              <h4 class="text-base font-bold text-slate-900 mb-1.5">${escapeHtml(item.pertanyaan)}</h4>
              <p class="text-sm text-slate-600 leading-relaxed">${escapeHtml(item.jawaban)}</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-2 flex-shrink-0">
              <button 
                onclick="editFaq(${item.id})"
                class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1 shadow-sm"
              >
                <i class="fa-solid fa-pen-to-square"></i>
                <span>Edit</span>
              </button>
              <button 
                onclick="deleteFaq(${item.id})"
                class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg transition flex items-center space-x-1 shadow-sm"
              >
                <i class="fa-solid fa-trash"></i>
                <span>Hapus</span>
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function updateChatbotShortcuts() {
      const shortcutBox = document.getElementById('chat-shortcuts');
      if (!shortcutBox) return;
      const topQuestions = faqData.slice(0, 4);
      shortcutBox.innerHTML = topQuestions.map(item => `
        <button onclick="sendQuickQuestion('${escapeHtml(item.pertanyaan).replace(/'/g, "\\'")}')" class="text-xs bg-white hover:bg-indigo-600 hover:text-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 transition-all duration-200 shadow-sm">
          ${escapeHtml(item.pertanyaan)}
        </button>
      `).join('');
    }

    // CREATE & UPDATE: Submit form ke POST /api/faq atau PUT /api/faq/:id
    async function handleFaqSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('faq-id').value;
      const kategori = document.getElementById('faq-kategori').value.trim();
      const pertanyaan = document.getElementById('faq-pertanyaan').value.trim();
      const jawaban = document.getElementById('faq-jawaban').value.trim();

      const isEdit = Boolean(id);
      const url = isEdit ? `/api/faq/${id}` : '/api/faq';
      const method = isEdit ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kategori, pertanyaan, jawaban })
        });
        const result = await res.json();

        if (!res.ok) {
          showAlert(result.message || 'Terjadi kesalahan saat menyimpan data', true);
          return;
        }

        showAlert(isEdit ? 'Data FAQ berhasil diperbarui di PostgreSQL!' : 'Data FAQ baru berhasil disimpan ke PostgreSQL!');
        resetFaqForm();
        await fetchFaqs();
      } catch (err) {
        showAlert('Gagal menghubungi server: ' + err.message, true);
      }
    }

    // Ambil detail item berdasarkan ID (GET /api/faq/:id) dan isi ke form edit
    async function editFaq(id) {
      try {
        const res = await fetch(`/api/faq/${id}`);
        const result = await res.json();
        if (!res.ok) {
          showAlert(result.message || 'Data tidak ditemukan', true);
          return;
        }

        const item = result.data;
        document.getElementById('faq-id').value = item.id;
        document.getElementById('faq-kategori').value = item.kategori;
        document.getElementById('faq-pertanyaan').value = item.pertanyaan;
        document.getElementById('faq-jawaban').value = item.jawaban;

        document.getElementById('form-title').innerHTML = `<i class="fa-solid fa-pen-to-square text-amber-500 mr-2"></i> Edit Data FAQ #${item.id}`;
        document.getElementById('form-mode-badge').textContent = `PUT /api/faq/${item.id}`;
        document.getElementById('form-mode-badge').className = 'px-2.5 py-0.5 text-xs font-semibold bg-amber-100 text-amber-800 rounded-full';
        document.getElementById('btn-submit-faq').innerHTML = `<i class="fa-solid fa-check"></i><span>Perbarui Data</span>`;
        document.getElementById('btn-submit-faq').className = 'flex-1 py-3 px-5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2';
        document.getElementById('btn-cancel-edit').classList.remove('hidden');

        document.getElementById('faq-crud').scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        showAlert('Gagal memuat detail FAQ: ' + err.message, true);
      }
    }

    function resetFaqForm() {
      document.getElementById('faq-form').reset();
      document.getElementById('faq-id').value = '';
      document.getElementById('form-title').innerHTML = `<i class="fa-solid fa-circle-plus text-indigo-600 mr-2"></i> Tambah Data FAQ Baru`;
      document.getElementById('form-mode-badge').textContent = 'POST /api/faq';
      document.getElementById('form-mode-badge').className = 'px-2.5 py-0.5 text-xs font-semibold bg-indigo-100 text-indigo-700 rounded-full';
      document.getElementById('btn-submit-faq').innerHTML = `<i class="fa-solid fa-floppy-disk"></i><span>Simpan ke Database</span>`;
      document.getElementById('btn-submit-faq').className = 'flex-1 py-3 px-5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2';
      document.getElementById('btn-cancel-edit').classList.add('hidden');
    }

    // DELETE: Hapus data berdasarkan ID (DELETE /api/faq/:id)
    async function deleteFaq(id) {
      if (!confirm(`Apakah Anda yakin ingin menghapus data FAQ ID #${id} dari database?`)) return;

      try {
        const res = await fetch(`/api/faq/${id}`, { method: 'DELETE' });
        const result = await res.json();

        if (!res.ok) {
          showAlert(result.message || 'Gagal menghapus data', true);
          return;
        }

        showAlert(`Data FAQ ID #${id} berhasil dihapus dari PostgreSQL.`);
        if (document.getElementById('faq-id').value == id) {
          resetFaqForm();
        }
        await fetchFaqs();
      } catch (err) {
        showAlert('Gagal menghapus data: ' + err.message, true);
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ==========================================
    // 2. LOGIKA CHATBOT AI (TERINTEGRASI DENGAN GOOGLE GEMINI & POSTGRESQL)
    // ==========================================

    function handleHeroSearch(e) {
      e.preventDefault();
      const heroInput = document.getElementById('hero-input');
      const val = heroInput ? heroInput.value.trim() : '';
      if (!val) return;

      const userInput = document.getElementById('user-input');
      if (userInput) userInput.value = val;

      document.getElementById('chat-demo').scrollIntoView({ behavior: 'smooth' });
      setTimeout(() => handleChatSubmit(null), 500);
    }

    async function handleChatSubmit(e) {
      if (e) e.preventDefault();
      const input = document.getElementById('user-input');
      const sendBtn = document.getElementById('btn-send-chat');
      const sendText = document.getElementById('btn-send-text');
      const sendIcon = document.getElementById('btn-send-icon');

      const text = input ? input.value.trim() : '';
      if (!text) return;

      // 1. Tampilkan pesan pengguna di antarmuka percakapan
      appendChatMessage('user', text);
      if (input) input.value = '';

      // 2. Nonaktifkan kontrol form dan tampilkan animasi loading
      if (sendBtn) sendBtn.disabled = true;
      if (sendText) sendText.innerText = 'Memproses...';
      if (sendIcon) sendIcon.className = 'fa-solid fa-spinner fa-spin text-xs';
      if (input) input.disabled = true;

      showChatLoading();

      try {
        // 3. Kirim pertanyaan ke backend melalui Fetch API (POST /api/chat)
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ message: text })
        });

        const result = await response.json();
        hideChatLoading();

        if (response.ok && result.success) {
          const replyText = (result.data && result.data.reply) ? result.data.reply : 'Tidak ada respon yang diterima.';
          appendChatMessage('bot', formatAiResponse(replyText));
        } else {
          // Tangani validasi gagal, prompt injection, atau error dari backend
          const errorMsg = result.message || 'Terjadi kendala saat memproses pertanyaan Anda.';
          appendChatMessage('bot', `
            <div class="text-rose-600 flex items-start space-x-2">
              <i class="fa-solid fa-circle-exclamation mt-0.5 text-rose-500"></i>
              <span>${escapeHtml(errorMsg)}</span>
            </div>
          `);
        }
      } catch (err) {
        hideChatLoading();
        console.error('Chat request error:', err);
        appendChatMessage('bot', `
          <div class="text-rose-600 flex items-start space-x-2">
            <i class="fa-solid fa-triangle-exclamation mt-0.5 text-rose-500"></i>
            <span>Gagal terhubung ke server backend: ${escapeHtml(err.message)}</span>
          </div>
        `);
      } finally {
        // 4. Pulihkan kontrol input dan tombol kirim
        if (sendBtn) sendBtn.disabled = false;
        if (sendText) sendText.innerText = 'Kirim';
        if (sendIcon) sendIcon.className = 'fa-solid fa-paper-plane text-xs';
        if (input) {
          input.disabled = false;
          input.focus();
        }
      }
    }

    function sendQuickQuestion(questionText) {
      const input = document.getElementById('user-input');
      if (input) input.value = questionText;
      document.getElementById('chat-demo').scrollIntoView({ behavior: 'smooth' });
      setTimeout(() => handleChatSubmit(null), 300);
    }

    function showChatLoading() {
      hideChatLoading();
      const box = document.getElementById('chat-box');
      const bubble = document.createElement('div');
      bubble.id = 'chat-loading-bubble';
      bubble.className = 'flex items-start space-x-3 chat-bubble-enter';
      bubble.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-600 to-purple-600 text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow animate-pulse">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl rounded-tl-none shadow-sm text-sm text-slate-600 flex items-center space-x-2">
          <span class="text-xs font-medium text-slate-500">Gemini AI sedang memproses context...</span>
          <span class="inline-flex space-x-1 items-center ml-1">
            <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
            <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
            <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
          </span>
        </div>
      `;
      box.appendChild(bubble);
      box.scrollTop = box.scrollHeight;
    }

    function hideChatLoading() {
      const loading = document.getElementById('chat-loading-bubble');
      if (loading) loading.remove();
    }

    function formatAiResponse(raw) {
      if (!raw) return '';
      // Escape HTML dasar untuk keamanan
      let safe = escapeHtml(raw);

      // Format bold markdown (**teks** -> <strong>teks</strong>)
      safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>');

      // Format list item dengan bullet point
      safe = safe.replace(/^[\*\-]\s+(.*)$/gm, '<div class="flex items-start space-x-1.5 my-1"><span class="text-indigo-600 font-bold">•</span><span>$1</span></div>');

      // Format baris baru
      safe = safe.replace(/\n\n/g, '<div class="h-2"></div>');
      safe = safe.replace(/\n/g, '<br>');

      return safe;
    }

    function appendChatMessage(sender, htmlContent) {
      const box = document.getElementById('chat-box');
      const wrapper = document.createElement('div');
      wrapper.className = `flex items-start space-x-3 chat-bubble-enter ${sender === 'user' ? 'justify-end' : ''}`;

      if (sender === 'user') {
        wrapper.innerHTML = `
          <div class="bg-indigo-600 text-white p-3.5 rounded-2xl rounded-tr-none shadow-sm max-w-md text-sm leading-relaxed">
            ${escapeHtml(htmlContent)}
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex-shrink-0 flex items-center justify-center text-xs font-bold shadow">
            <i class="fa-solid fa-user"></i>
          </div>
        `;
      } else {
        wrapper.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-600 to-purple-600 text-white flex-shrink-0 flex items-center justify-center text-xs font-bold shadow">
            <i class="fa-solid fa-robot"></i>
          </div>
          <div class="bg-white border border-slate-200 p-3.5 rounded-2xl rounded-tl-none shadow-sm max-w-lg text-sm text-slate-700 leading-relaxed space-y-1">
            ${htmlContent}
          </div>
        `;
      }

      box.appendChild(wrapper);
      box.scrollTop = box.scrollHeight;
    }

    // ==========================================
    // 3. LIVE API TESTER
    // ==========================================

    async function testApi(url, outputId, badgeId) {
      const outputElem = document.getElementById(outputId);
      const badgeElem = document.getElementById(badgeId);

      badgeElem.innerHTML = `<span class="text-amber-500 font-semibold">Mengirim Request...</span>`;
      const t0 = performance.now();
      try {
        const res = await fetch(url);
        const duration = Math.round(performance.now() - t0);
        const data = await res.json();

        badgeElem.innerHTML = `<span class="text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">${res.status} OK (${duration}ms)</span>`;
        outputElem.innerText = JSON.stringify(data, null, 2);
      } catch (err) {
        badgeElem.innerHTML = `<span class="text-rose-600 font-bold">Error</span>`;
        outputElem.innerText = `Error: ${err.message}`;
      }
    }

    async function testChatApi() {
      const input = document.getElementById('test-chat-input');
      const outputElem = document.getElementById('chat-output');
      const badgeElem = document.getElementById('chat-badge');
      const message = input ? input.value.trim() : '';

      badgeElem.innerHTML = `<span class="text-amber-500 font-semibold">Mengirim ke Gemini...</span>`;
      outputElem.innerText = '// Mengirim permintaan ke backend POST /api/chat...\n// Menyiapkan context database dan menjalankan inferensi Gemini LLM...';

      const t0 = performance.now();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });
        const duration = Math.round(performance.now() - t0);
        const data = await res.json();

        if (res.ok) {
          badgeElem.innerHTML = `<span class="text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">${res.status} OK (${duration}ms)</span>`;
        } else {
          badgeElem.innerHTML = `<span class="text-rose-600 font-bold bg-rose-50 px-2 py-0.5 rounded border border-rose-200">${res.status} Error (${duration}ms)</span>`;
        }
        outputElem.innerText = JSON.stringify(data, null, 2);
      } catch (err) {
        badgeElem.innerHTML = `<span class="text-rose-600 font-bold">Error</span>`;
        outputElem.innerText = `Error: ${err.message}`;
      }
    }
  </script>
</body>
